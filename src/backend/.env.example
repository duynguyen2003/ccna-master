BACKEND_PORT=5500
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/netmastery_db
JWT_SECRET=replace_with_a_unique_secret_at_least_32_characters
JWT_EXPIRES_IN=24h
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
TRUST_PROXY=0
# Optional: absolute path, or a path relative to the repository root.
UPLOADS_DIR=src/storage/uploads

# Captured at attempt start; changing these does not regrade existing attempts.
LAB_LEARNING_OBSERVATIONS_ENABLED=0
LAB_MASTERY_ENABLED=0
# AI trạng thái SSE: tắt để browser dùng polling. Chạy db:deploy trước khi bật.
AI_STATUS_STREAM_ENABLED=false
AI_TIMINGS_ENABLED=false
AI_PYTHON_TRACE_TIMINGS=false
