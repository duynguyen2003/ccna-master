// ==========================================
// THIẾT LẬP KẾT NỐI (DATASOURCE & GENERATOR)
// ==========================================
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ĐỊNH NGHĨA CÁC ENUMS (KIỂU DỮ LIỆU ĐẶC BIỆT)
// ==========================================
enum Role {
  STUDENT
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ProgressStatus {
  LOCKED
  ACTIVE
  COMPLETED
}

enum LabType {
  PACKET_TRACER
  CLI_SIMULATION
}

enum LabAttemptStatus {
  IN_PROGRESS
  PASSED
  FAILED
}

// ==========================================
// KHỐI 1: NGƯỜI DÙNG & BẢO MẬT
// ==========================================

model User {
  id             Int       @id @default(autoincrement())
  fullName       String?   @map("full_name") @db.VarChar(100)
  email          String    @unique @db.VarChar(150)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  avatarUrl      String?   @map("avatar_url") @db.Text
  role           Role      @default(STUDENT)
  level          Int       @default(1)
  streak         Int       @default(0)
  totalStudyTime Int       @default(0) @map("total_study_time") // Phút
  isActive       Boolean   @default(true) @map("is_active")
  sessionVersion Int       @default(0) @map("session_version")
  lastLogin      DateTime? @map("last_login")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at") // Xóa mềm

  // Quan hệ (Relations)
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  progress              UserProgress[]
  examResults           ExamResult[]
  examAttempts          ExamAttempt[]
  notes                 UserNote[]
  activities            UserActivity[]
  badges                UserBadge[]
  adminLogs             AdminLog[]
  videoProgress         VideoProgress[]
  videoProgressSessions VideoProgressSession[]
  studyLogs             StudyLog[]
  labAttempts           LabAttempt[]
  aiConversations       AiConversation[]
  aiRequests            AiRequest[]
  aiFeedback            AiFeedback[]
  aiPoliciesUpdated     AiRuntimePolicy[]

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ==========================================
// KHỐI 2: NỘI DUNG KHÓA HỌC (ROADMAP)
// ==========================================

model Course {
  id           String    @id @db.VarChar(10) // vđ: c1, c2
  code         String    @db.VarChar(10) // vđ: ITN, SRWE
  title        String    @db.VarChar(200)
  description  String?   @db.Text
  thumbnailUrl String?   @map("thumbnail_url") @db.Text
  level        String    @default("BEGINNER") @db.VarChar(50)
  status       String    @default("DRAFT") @db.VarChar(50)
  orderIndex   Int       @default(0) @map("order_index")
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  modules   Module[]
  topics    CourseTopic[]
  labs      Lab[]
  exams     Exam[]
  progress  UserProgress[]
  resources Resource[]

  @@map("courses")
}

model CourseTopic {
  id         Int    @id @default(autoincrement())
  courseId   String @map("course_id") @db.VarChar(10)
  title      String @db.VarChar(500) // Ví dụ: "IPv4 & IPv6"
  orderIndex Int    @default(0) @map("order_index")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("course_topics")
}

model Module {
  id          String    @id @db.VarChar(10) // vđ: m1
  courseId    String    @map("course_id") @db.VarChar(10)
  title       String    @db.VarChar(200)
  description String?   @db.Text
  orderIndex  Int       @map("order_index")
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]
  labs     Lab[]
  exams    Exam[]
  progress UserProgress[]

  @@map("modules")
}

model Lesson {
  id            Int       @id @default(autoincrement())
  moduleId      String    @map("module_id") @db.VarChar(10)
  title         String    @db.VarChar(200)
  sectionNumber String?   @map("section_number") @db.VarChar(20)
  contentHtml   String?   @map("content_html") @db.Text
  videoUrl      String?   @map("video_url") @db.Text
  videoDuration String?   @map("video_duration") @db.VarChar(20)
  orderIndex    Int       @map("order_index")
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  module                Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress              UserProgress[]
  notes                 UserNote[]
  videoProgress         VideoProgress[]
  videoProgressSessions VideoProgressSession[]

  @@map("lessons")
}

model Lab {
  id               Int        @id @default(autoincrement())
  title            String     @db.VarChar(1000)
  category         String?    @db.VarChar(50)
  difficulty       Difficulty @default(EASY)
  duration         String?    @db.VarChar(20)
  imageUrl         String?    @map("image_url") @db.Text // Ảnh đại diện bài Lab
  topologyImgUrl   String?    @map("topology_img_url") @db.Text // Ảnh sơ đồ mạng
  objective        String?    @db.Text // Mục tiêu bài tập
  tools            Json? // Danh sách công cụ (Packet Tracer...)
  fileUrl          String?    @map("file_url") @db.Text // File bài tập .pka/.pkt
  steps            Json? // Các bước hướng dẫn (Array of objects)
  guideContent     String?    @map("guide_content") @db.Text // Mô tả/Hướng dẫn chung
  status           String     @default("DRAFT") @db.VarChar(50)
  labType          LabType    @default(PACKET_TRACER) @map("lab_type")
  simulatorVersion String?    @map("simulator_version") @db.VarChar(20)
  commandProfile   String?    @map("command_profile") @db.VarChar(50)
  initialState     Json?      @map("initial_state")
  gradingSpec      Json?      @map("grading_spec")
  courseId         String?    @map("course_id") @db.VarChar(10)
  moduleId         String?    @map("module_id") @db.VarChar(10)
  createdAt        DateTime   @default(now()) @map("created_at")
  deletedAt        DateTime?  @map("deleted_at")

  course   Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module   Module?        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress UserProgress[]
  attempts LabAttempt[]

  @@map("labs")
}

model LabAttempt {
  definition       Json?
  members          Json?
  id               String           @id @default(uuid()) @db.Uuid
  userId           Int              @map("user_id")
  labId            Int              @map("lab_id")
  status           LabAttemptStatus @default(IN_PROGRESS)
  deviceState      Json             @map("device_state")
  score            Int?
  feedback         Json?
  simulatorVersion String           @map("simulator_version") @db.VarChar(20)
  startedAt        DateTime         @default(now()) @map("started_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  submittedAt      DateTime?        @map("submitted_at")

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab      Lab          @relation(fields: [labId], references: [id], onDelete: Cascade)
  commands LabCommand[]

  publicMetadata           Json?               @map("public_metadata")
  publicMetadataProvenance AiSourceProvenance? @map("public_metadata_provenance")
  publicMetadataCapturedAt DateTime?           @map("public_metadata_captured_at") @db.Timestamptz(3)
  feedbackRevision         Int?                @map("feedback_revision")
  feedbackRecordedAt       DateTime?           @map("feedback_recorded_at") @db.Timestamptz(3)
  safeFeedbackSnapshot     Json?               @map("safe_feedback_snapshot")
  feedbackProvenance       AiSourceProvenance? @map("feedback_provenance")
  aiConversations          AiConversation[]
  aiRequests               AiRequest[]

  @@index([userId, labId, status])
  @@map("lab_attempts")
}

model LabCommand {
  action    Json?
  id        Int      @id @default(autoincrement())
  attemptId String   @map("attempt_id") @db.Uuid
  sequence  Int
  command   String   @db.VarChar(500)
  mode      String   @db.VarChar(30)
  prompt    String   @db.VarChar(100)
  output    String?  @db.Text
  isError   Boolean  @default(false) @map("is_error")
  createdAt DateTime @default(now()) @map("created_at")

  attempt LabAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, sequence])
  @@index([attemptId, createdAt])
  @@map("lab_commands")
}

// ==========================================
// KHỐI 3: KHẢO THÍ (THI TRẮC NGHIỆM)
// ==========================================

model Exam {
  id              Int       @id @default(autoincrement())
  title           String    @db.VarChar(200)
  examCode        String?   @map("exam_code") @db.VarChar(20)
  totalQuestions  Int       @map("total_questions")
  durationMinutes Int       @map("duration_minutes")
  passingScore    Int       @default(70) @map("passing_score")
  difficulty      String?   @db.VarChar(20)
  courseId        String?   @map("course_id") @db.VarChar(10)
  moduleId        String?   @map("module_id") @db.VarChar(10)
  createdAt       DateTime  @default(now()) @map("created_at")
  deletedAt       DateTime? @map("deleted_at")
  status          String    @default("DRAFT") @db.VarChar(20)

  course    Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module    Module?        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions ExamQuestion[]
  results   ExamResult[]
  attempts  ExamAttempt[]

  @@map("exams")
}

model ExamQuestion {
  id            Int     @id @default(autoincrement())
  examId        Int     @map("exam_id")
  question      String  @db.Text
  imageUrl      String? @map("image_url") @db.Text
  options       Json // Các đáp án (Lưu dạng mảng JSON)
  correctAnswer Json    @map("correct_answer") // Array of indices [0, 2]
  explanation   String? @db.Text
  orderIndex    Int     @map("order_index")

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@map("exam_questions")
}

model ExamAttempt {
  id           String    @id @default(uuid()) @db.Uuid
  userId       Int       @map("user_id")
  examId       Int       @map("exam_id")
  examSnapshot Json      @map("exam_snapshot")
  startedAt    DateTime  @default(now()) @map("started_at")
  expiresAt    DateTime  @map("expires_at")
  submittedAt  DateTime? @map("submitted_at")

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam   Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  result ExamResult?

  @@index([userId, examId, submittedAt])
  @@map("exam_attempts")
}

model ExamResult {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  examId         Int      @map("exam_id")
  attemptId      String?  @unique @map("attempt_id") @db.Uuid
  examSnapshot   Json?    @map("exam_snapshot")
  score          Int
  totalQuestions Int      @map("total_questions")
  percentage     Decimal  @db.Decimal(5, 2)
  isPassed       Boolean  @map("is_passed")
  answers        Json // Lịch sử người dùng đã chọn những gì
  timeSpent      Int      @map("time_spent") // Tính bằng giây
  takenAt        DateTime @default(now()) @map("taken_at")

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  attempt ExamAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@map("exam_results")
}

// ==========================================
// KHỐI 4: TƯƠNG TÁC & THEO DÕI NGƯỜI DÙNG
// ==========================================

model UserProgress {
  id              Int            @id @default(autoincrement())
  userId          Int            @map("user_id")
  courseId        String         @map("course_id") @db.VarChar(10)
  moduleId        String?        @map("module_id") @db.VarChar(10)
  lessonId        Int?           @map("lesson_id")
  labId           Int?           @map("lab_id")
  status          ProgressStatus @default(LOCKED)
  progressPercent Int            @default(0) @map("progress_percent")
  completedAt     DateTime?      @map("completed_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lab    Lab?    @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@map("user_progress")
}

model Resource {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(300)
  type      String   @db.VarChar(20)
  size      String?  @db.VarChar(20)
  fileUrl   String?  @map("file_url") @db.Text
  courseId  String?  @map("course_id") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")

  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("resources")
}

model UserBadge {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  badgeName String   @map("badge_name") @db.VarChar(100)
  badgeIcon String?  @map("badge_icon") @db.VarChar(50)
  earnedAt  DateTime @default(now()) @map("earned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_badges")
}

model UserActivity {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  title       String   @db.VarChar(200)
  type        String   @db.VarChar(50)
  referenceId Int?     @map("reference_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_activity")
}

model UserNote {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  lessonId  Int      @map("lesson_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("user_notes")
}

// ==========================================
// KHỐI 5: HỆ THỐNG NHẬT KÝ (LOGS)
// ==========================================

model AdminLog {
  id          Int      @id @default(autoincrement())
  adminId     Int      @map("admin_id") // Liên kết với User.id (Những người có role Admin)
  action      String   @db.VarChar(50)
  targetTable String   @map("target_table") @db.VarChar(50)
  targetId    String?  @map("target_id") @db.VarChar(50)
  details     String?  @db.Text
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at")

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_logs")
}

// Khối mới thêm: CÔNG CỤ HỖ TRỢ
model Tool {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(100) // Tên công cụ (vd: Trình tính toán Subnet)
  description String?  @db.Text // Mô tả ngắn
  iconName    String?  @map("icon_name") @db.VarChar(50) // Tên icon để React hiển thị
  linkUrl     String?  @map("link_url") @db.Text // Đường dẫn khi click vào
  isActive    Boolean  @default(true) @map("is_active")
  orderIndex  Int      @default(0) @map("order_index") // Vị trí sắp xếp
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("tools") // Tên bảng sẽ hiển thị trong DBeaver
}

// Khối mới thêm: NGÂN HÀNG CÂU HỎI & KỊCH BẢN (DOMAIN-SPECIFIC FEATURES)
model QuestionBank {
  id              Int        @id @default(autoincrement())
  title           String     @db.VarChar(200)
  type            String     @db.VarChar(50) // Ví dụ: "MULTIPLE_CHOICE", "CLI_SIMULATION", "AI_PROMPT"
  content         String     @db.Text // Nội dung câu hỏi / kịch bản CLI
  topologyImgUrl  String?    @map("topology_img_url") @db.Text // Hình ảnh sơ đồ mạng (tuỳ chọn)
  configData      Json? // Cấu hình mạng mẫu (dành cho CLI simulation)
  aiPromptContext String?    @map("ai_prompt_context") @db.Text // Context hoặc prompt cho trợ lý AI
  options         Json? // Đáp án hoặc data mở rộng
  correctAnswer   String?    @map("correct_answer") @db.Text // Đáp án / lệnh đúng
  difficulty      Difficulty @default(MEDIUM)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@map("question_bank")
}

model VideoProgress {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  lessonId       Int       @map("lesson_id")
  watchedSeconds Int       @default(0) @map("watched_seconds")
  lastPosition   Int       @default(0) @map("last_position")
  lastPositionAt DateTime? @map("last_position_at")
  isCompleted    Boolean   @default(false) @map("is_completed")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("video_progress")
}

model VideoProgressSession {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  lessonId       Int      @map("lesson_id")
  sessionId      String   @map("session_id") @db.Uuid
  startedAt      DateTime @map("started_at")
  lastSequence   Int      @map("last_sequence")
  lastCapturedAt DateTime @map("last_captured_at")
  watchedSeconds Int      @default(0) @map("watched_seconds")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, sessionId])
  @@map("video_progress_sessions")
}

model StudyLog {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  date     DateTime @default(now()) @db.Date
  duration Int      @default(0) // Giây

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("study_logs")
}

// AI R1 storage. SQL checks and delete-retention rules are documented by BE-01.
enum AiRequestStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
  REVOKED
  DELETED
  OUTCOME_UNKNOWN
}

enum AiResponseMode {
  NONE
  LLM
  DETERMINISTIC
}

enum AiIntent {
  NEXT_STEP
  DIAGNOSE
  EXPLAIN_CONCEPT
  LAB_REVIEW
}

enum AiSourceProvenance {
  LIVE_SNAPSHOT
  FEEDBACK_SNAPSHOT
  LEGACY_FEEDBACK
  CAPTURED_AT_ATTEMPT_START
  CAPTURED_AT_AI_REQUEST
}

enum AiMessageRole {
  USER
  ASSISTANT
}

enum AiProviderCallState {
  PLANNED
  DISPATCHED
  RECEIVED
  KNOWN_FAILURE
  OUTCOME_UNKNOWN
}

enum AiUsageStatus {
  PENDING
  FINAL
  UNRESOLVED
  ESTIMATED
}

enum AiQuotaScope {
  USER_MINUTE
  USER_DAY
  GLOBAL_DAY
  GLOBAL_MONTH
}

enum AiReservationStatus {
  RESERVED
  SETTLED
  RELEASED
  UNRESOLVED
}

model AiConversation {
  id         String    @id @default(uuid()) @db.Uuid
  userId     Int?      @map("user_id")
  attemptId  String?   @map("attempt_id") @db.Uuid
  ownerKey   String    @map("owner_key") @db.VarChar(160)
  epoch      Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  purgeAfter DateTime? @map("purge_after") @db.Timestamptz(3)

  // Detach nullable identity only after cancel/purge; no silent account cascade.
  user     User?       @relation(fields: [userId], references: [id], onDelete: Restrict)
  attempt  LabAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  requests AiRequest[]
  messages AiMessage[]

  @@unique([userId, attemptId])
  @@unique([id, userId, attemptId])
  @@index([deletedAt, purgeAfter])
  @@map("ai_conversations")
}

model AiRequest {
  id                        String             @id @default(uuid()) @db.Uuid
  userId                    Int?               @map("user_id")
  attemptId                 String?            @map("attempt_id") @db.Uuid
  conversationId            String?            @map("conversation_id") @db.Uuid
  ownerKey                  String             @map("owner_key") @db.VarChar(160)
  conversationEpoch         Int                @map("conversation_epoch")
  recoveryEpoch             String             @map("recovery_epoch") @db.VarChar(80)
  clientRequestId           String             @map("client_request_id") @db.Uuid
  payloadHash               String             @map("payload_hash") @db.Char(64)
  status                    AiRequestStatus    @default(QUEUED)
  responseMode              AiResponseMode     @default(NONE) @map("response_mode")
  intent                    AiIntent
  requestedHintLevel        Int?               @map("requested_hint_level")
  effectiveHintLevel        Int                @default(1) @map("effective_hint_level")
  sourceRevision            Int?               @map("source_revision")
  sourceProvenance          AiSourceProvenance @map("source_provenance")
  snapshot                  Json?
  contextHash               String             @map("context_hash") @db.Char(64)
  versions                  Json
  sessionVersionAtAdmission Int                @map("session_version_at_admission")
  maxCostMicros             BigInt             @map("max_cost_micros")
  deadlineAt                DateTime           @map("deadline_at") @db.Timestamptz(3)
  leaseOwner                String?            @map("lease_owner") @db.VarChar(160)
  leaseVersion              Int                @default(0) @map("lease_version")
  leaseExpiresAt            DateTime?          @map("lease_expires_at") @db.Timestamptz(3)
  heartbeatAt               DateTime?          @map("heartbeat_at") @db.Timestamptz(3)
  errorCode                 String?            @map("error_code") @db.VarChar(80)
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  startedAt                 DateTime?          @map("started_at") @db.Timestamptz(3)
  finishedAt                DateTime?          @map("finished_at") @db.Timestamptz(3)
  purgedAt                  DateTime?          @map("purged_at") @db.Timestamptz(3)

  user           User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  attempt        LabAttempt?       @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  conversation   AiConversation?   @relation(fields: [conversationId, userId, attemptId], references: [id, userId, attemptId], onDelete: Restrict, onUpdate: Restrict)
  messages       AiMessage[]
  providerCalls  AiProviderCall[]
  reservations   AiReservation[]
  executionSlots AiExecutionSlot[]

  @@unique([userId, clientRequestId])
  @@unique([ownerKey, clientRequestId])
  @@unique([id, conversationId, conversationEpoch])
  @@unique([id, contextHash])
  // Use PostgreSQL's canonical enum predicate so migrate diff remains empty.
  @@unique([userId], map: "ai_requests_one_active_user", where: raw("(status = ANY (ARRAY['QUEUED'::\"AiRequestStatus\", 'RUNNING'::\"AiRequestStatus\"]))"))
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([conversationId, conversationEpoch, createdAt])
  @@index([status, leaseExpiresAt])
  @@map("ai_requests")
}

model AiMessage {
  id               String        @id @default(uuid()) @db.Uuid
  conversationId   String        @map("conversation_id") @db.Uuid
  epoch            Int
  requestId        String        @map("request_id") @db.Uuid
  role             AiMessageRole
  content          String?       @db.Text
  structuredAnswer Json?         @map("structured_answer")
  sourceRevision   Int?          @map("source_revision")
  evidenceRefs     Json?         @map("evidence_refs")
  evidenceSnapshot Json?         @map("evidence_snapshot")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  request      AiRequest      @relation(fields: [requestId, conversationId, epoch], references: [id, conversationId, conversationEpoch], onDelete: Restrict, onUpdate: Restrict)
  feedback     AiFeedback[]

  @@unique([requestId, role])
  @@index([conversationId, epoch, createdAt, id])
  @@map("ai_messages")
}

model AiProviderCall {
  id                String              @id @default(uuid()) @db.Uuid
  requestId         String              @map("request_id") @db.Uuid
  stepIndex         Int                 @default(0) @map("step_index")
  contextHash       String              @map("context_hash") @db.Char(64)
  provider          String              @db.VarChar(40)
  model             String              @db.VarChar(120)
  priceVersion      String              @map("price_version") @db.VarChar(80)
  state             AiProviderCallState @default(PLANNED)
  leaseVersion      Int                 @map("lease_version")
  providerRequestId String?             @map("provider_request_id") @db.VarChar(200)
  inputTokens       Int?                @map("input_tokens")
  outputTokens      Int?                @map("output_tokens")
  reasoningTokens   Int?                @map("reasoning_tokens")
  maxCostMicros     BigInt              @map("max_cost_micros")
  costMicros        BigInt?             @map("cost_micros")
  usageStatus       AiUsageStatus       @default(PENDING) @map("usage_status")
  currency          String              @default("USD") @db.Char(3)
  receiptHash       String?             @map("receipt_hash") @db.Char(64)
  receiptPayload    Json?               @map("receipt_payload")
  analyzeInput      Json?               @map("analyze_input")
  receiptExpiresAt  DateTime?           @map("receipt_expires_at") @db.Timestamptz(3)
  suppressionReason String?             @map("suppression_reason") @db.VarChar(80)
  finishReason      String?             @map("finish_reason") @db.VarChar(80)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  dispatchedAt      DateTime?           @map("dispatched_at") @db.Timestamptz(3)
  receivedAt        DateTime?           @map("received_at") @db.Timestamptz(3)

  request        AiRequest           @relation(fields: [requestId, contextHash], references: [id, contextHash], onDelete: Restrict, onUpdate: Restrict)
  adjustments    AiUsageAdjustment[]
  executionSlots AiExecutionSlot[]

  @@unique([requestId, stepIndex])
  @@unique([id, requestId])
  @@index([usageStatus, createdAt])
  @@index([receiptExpiresAt])
  @@map("ai_provider_calls")
}

model AiQuotaBucket {
  id             String          @id @default(uuid()) @db.Uuid
  scopeType      AiQuotaScope    @map("scope_type")
  // Include environment and a pseudonymous owner key, never email/credential.
  scopeKey       String          @map("scope_key") @db.VarChar(200)
  windowStart    DateTime        @map("window_start") @db.Timestamptz(3)
  windowEnd      DateTime        @map("window_end") @db.Timestamptz(3)
  limitUnits     Int             @default(0) @map("limit_units")
  usedUnits      Int             @default(0) @map("used_units")
  reservedUnits  Int             @default(0) @map("reserved_units")
  limitMicros    BigInt          @default(0) @map("limit_micros")
  spentMicros    BigInt          @default(0) @map("spent_micros")
  reservedMicros BigInt          @default(0) @map("reserved_micros")
  reservations   AiReservation[]

  @@unique([scopeType, scopeKey, windowStart])
  @@index([windowEnd])
  @@map("ai_quota_buckets")
}

model AiReservation {
  id                String              @id @default(uuid()) @db.Uuid
  requestId         String              @map("request_id") @db.Uuid
  bucketId          String              @map("bucket_id") @db.Uuid
  units             Int                 @default(0)
  costMicros        BigInt              @map("cost_micros")
  status            AiReservationStatus @default(RESERVED)
  settlementKey     String?             @unique @map("settlement_key") @db.VarChar(200)
  settledUnits      Int?                @map("settled_units")
  unitUsed          Int?                @map("unit_used")
  settledCostMicros BigInt?             @map("settled_cost_micros")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  settledAt         DateTime?           @map("settled_at") @db.Timestamptz(3)

  request AiRequest     @relation(fields: [requestId], references: [id], onDelete: Restrict)
  bucket  AiQuotaBucket @relation(fields: [bucketId], references: [id], onDelete: Restrict)

  @@unique([requestId, bucketId])
  @@index([status, createdAt])
  @@map("ai_reservations")
}

model AiUsageAdjustment {
  id             String         @id @default(uuid()) @db.Uuid
  providerCallId String         @map("provider_call_id") @db.Uuid
  idempotencyKey String         @unique @map("idempotency_key") @db.VarChar(200)
  deltaMicros    BigInt         @map("delta_micros")
  reason         String         @db.VarChar(80)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  providerCall   AiProviderCall @relation(fields: [providerCallId], references: [id], onDelete: Restrict)

  @@index([providerCallId, createdAt])
  @@map("ai_usage_adjustments")
}

model AiRuntimePolicy {
  environment      String            @id @db.VarChar(40)
  version          Int               @default(1)
  admissionEnabled Boolean           @default(false) @map("admission_enabled")
  dispatchEnabled  Boolean           @default(false) @map("dispatch_enabled")
  eligibilityRules Json              @default("{}") @map("eligibility_rules")
  limits           Json              @default("{}")
  providerConfigId String?           @map("provider_config_id") @db.VarChar(80)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy        Int?              @map("updated_by")
  updater          User?             @relation(fields: [updatedBy], references: [id], onDelete: SetNull)
  executionSlots   AiExecutionSlot[]

  @@map("ai_runtime_policies")
}

model AiExecutionSlot {
  environment  String    @db.VarChar(40)
  slotNumber   Int       @map("slot_number")
  requestId    String?   @unique @map("request_id") @db.Uuid
  callId       String?   @unique @map("call_id") @db.Uuid
  leaseVersion Int       @default(0) @map("lease_version")
  acquiredAt   DateTime? @map("acquired_at") @db.Timestamptz(3)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3)

  policy  AiRuntimePolicy @relation(fields: [environment], references: [environment], onDelete: Restrict)
  request AiRequest?      @relation(fields: [requestId], references: [id], onDelete: Restrict)
  call    AiProviderCall? @relation(fields: [callId, requestId], references: [id, requestId], onDelete: Restrict, onUpdate: Restrict)

  @@id([environment, slotNumber])
  @@index([expiresAt])
  @@map("ai_execution_slots")
}

model AiFeedback {
  id              String    @id @default(uuid()) @db.Uuid
  messageId       String    @map("message_id") @db.Uuid
  userId          Int       @map("user_id")
  helpful         Boolean
  reasonCode      String?   @map("reason_code") @db.VarChar(80)
  optionalComment String?   @map("optional_comment") @db.VarChar(1000)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  message         AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("ai_feedback")
}

model AiEventOutbox {
  eventId       String    @id @default(uuid()) @map("event_id") @db.Uuid
  type          String    @db.VarChar(80)
  version       Int       @default(1)
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  exportedAt    DateTime? @map("exported_at") @db.Timestamptz(3)
  retryCount    Int       @default(0) @map("retry_count")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)

  @@index([nextAttemptAt, eventId], map: "ai_event_outbox_pending_idx", where: raw("exported_at IS NULL"))
  @@map("ai_event_outbox")
}
