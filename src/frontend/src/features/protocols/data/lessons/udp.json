  "overview": {
    "full": "User Datagram Protocol",
    "description": "UDP sends data in independent packets called datagrams, with no connection, no acknowledgements and no resends. That keeps it fast and light: right for voice, video, games and DNS, where a late answer is worse than a missing one.",
    "facts": [
      [
        "Layer",
        "Transport (Layer 4)"
      ],
      [
        "Connection",
        "None"
      ],
      [
        "Reliability",
        "None (no ACKs, no resends)"
      ],
      [
        "Ordering",
        "Not guaranteed"
      ],
      [
        "Header",
        "8 bytes"
      ],
      [
        "Defined In",
        "RFC 768"
      ]
    ]
  },
  "outro": {
    "title": "Call keeps flowing",
    "desc": "Fast, simple, no guarantees",
    "text": "Audio started with the very first packet, every datagram travelled on its own, and the one that was lost was simply gone: UDP never noticed. The app covered the gap and the call carried on. Press REPLAY to watch it again.",
