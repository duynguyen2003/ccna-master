  "overview": {
    "full": "Server Message Block (SMB 3)",
    "description": "SMB is how Windows shares files and printers: \\\\server\\share in File Explorer, a mapped network drive, a NAS at home. macOS and Linux speak it too. Over one TCP connection to port 445 the client agrees on a version, logs in and connects to a share, then opens, reads, writes and closes files with numbered requests.",
    "facts": [
      [
        "Layer",
        "Application (Layer 7)"
      ],
      [
        "Port",
        "TCP 445"
      ],
      [
        "Version",
        "SMB 3.1.1"
      ],
      [
        "Login",
        "NTLM or Kerberos"
      ],
      [
        "Protection",
        "Signing, optional encryption"
      ],
      [
        "Defined In",
        "MS-SMB2 (Microsoft)"
      ]
    ]
  },
  "outro": {
    "title": "File read",
    "desc": "Seven requests, one connection",
    "text": "Over one TCP connection the laptop agreed on SMB 3.1.1, logged in with NTLM without sending its password, connected to the share and read a 240 KB file with a single request. Every message after the login was signed. Press REPLAY to watch it again.",
    "facts": [
