  "overview": {
    "full": "Real Time Streaming Protocol",
    "description": "RTSP is how video players, recorders and security apps get live video from IP cameras. It works like a remote control: the player asks what the camera offers, sets up a stream, and says PLAY and later TEARDOWN, in text messages much like HTTP. The video itself doesn’t travel in RTSP: it flows separately as RTP, here over UDP.",
    "facts": [
      [
        "Layer",
        "Application (Layer 7)"
      ],
      [
        "Port",
        "TCP 554"
      ],
      [
        "Controls",
        "SETUP, PLAY, TEARDOWN"
      ],
      [
        "Video",
        "RTP, described by SDP"
      ],
      [
        "Codec here",
        "H.264"
      ],
      [
        "Defined In",
        "RFC 2326 (2.0: RFC 7826)"
      ]
    ]
  },
  "outro": {
    "title": "Watched",
    "desc": "Described, set up, played, stopped",
    "text": "VLC asked the camera what it had, logged in with a hash of its password, set up one video track and pressed PLAY. The video came as RTP packets on ports of its own, a key frame in three pieces, until TEARDOWN ended the session. Press REPLAY to watch it again.",
    "facts": [
      [
        "Requests",
        "6 on one TCP connection"
      ],
      [
        "Video",
        "RTP, UDP 6970 → 50000"
      ],
      [
        "Key frame",
        "Split into 3 packets"
      ],
      [
        "Session",
        "1185d200, 60 s timeout"
      ]
    ]
  },
