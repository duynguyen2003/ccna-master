  "overview": {
    "full": "Transport Layer Security",
    "description": "TLS puts a secure channel on top of TCP. It proves the server’s identity with a certificate, agrees on fresh keys, then encrypts and authenticates everything sent. HTTPS, secure email and many other protocols run inside it. SSL was the name of its predecessor.",
    "facts": [
      [
        "Sits",
        "Between TCP and the app"
      ],
      [
        "OSI layer",
        "Often placed at 6"
      ],
      [
        "Current",
        "TLS 1.3 (RFC 8446)"
      ],
      [
        "Retired",
        "SSL 2 and 3, TLS 1.0 and 1.1"
      ],
      [
        "Proves",
        "Server identity (certificate)"
      ],
      [
        "Port",
        "The app’s own (443, 993 …)"
      ]
    ]
  },
  "outro": {
    "title": "Secure from start to finish",
    "desc": "One round trip to set up",
    "text": "One round trip agreed on a version, a cipher and a post-quantum hybrid key. The certificate chain proved who the server was, and every byte after the Server Hello was encrypted and authenticated, right up to the close_notify. Press REPLAY to watch it again.",
    "facts": [
      [
