    {
      "title": "No Security",
      "desc": "Anyone who can reach it",
      "detail": "Nothing in these messages says who sent them: Modbus, from 1979, has no login and no encryption, so any device that can reach port 502 can read the values and start the pump. Plants protect it with separate networks, firewalls between office and plant, lists of who may talk to each PLC, and monitoring. Modbus/TCP Security wraps the same messages in TLS, on port 802.",
      "facts": [
        [
          "Login",
          "None"
        ],
        [
          "Encryption",
          "None"
        ],
        [
          "Protect with",
          "Separate networks, TLS"
        ]
      ],
      "events": [
        {
          "type": "note",
          "at": "lan",
          "text": "NO LOGIN, NO ENCRYPTION",
          "tone": "amber"
        }
      ]
    }
