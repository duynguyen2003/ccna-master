    {
      "title": "Read Registers",
      "desc": "Function 3: four numbers",
      "detail": "The laptop asks for 4 holding registers starting at address 0, with function code 3. The PLC answers with 8 bytes: four 16-bit numbers. What they mean (the tank level in centimetres, the temperature in tenths of a degree) is written only in the PLC’s documentation; the message carries no names and no units. An HMI screen sends reads like this every second or so.",
      "facts": [
        [
          "Function",
          "3, Read Holding Registers"
        ],
        [
          "Asks for",
          "4 registers from 0"
        ],
        [
          "Answer",
          "412, 183, 1450, 450"
        ]
      ],
      "events": [
        {
          "type": "packet",
          "from": "client",
          "to": "lan",
          "color": "amber",
          "label": "READ",
          "payload": [
            "function 3",
            "registers 0–3"
          ],
          "row": {
            "time": "0.002s",
            "src": "192.168.1.10",
            "dst": "192.168.1.20",
            "proto": "Modbus/TCP",
            "info": "Query: Trans: 1; Unit: 1, Func: 3: Read Holding Registers",
            "len": "66 B",
            "wire": {
              "tcp": {
                "sport": 51874,
                "dport": 502,
                "flags": "PA",
                "data": {
                  "modbus": {
                    "tid": 1,
                    "fn": 3,
                    "address": 0,
                    "count": 4
                  }
                }
              }
            }
          }
        },
        {
          "type": "packet",
          "from": "lan",
          "to": "client",
          "color": "violet",
          "label": "VALUES",
          "payload": [
            "412, 183, 1450, 450"
          ],
          "row": {
            "time": "0.005s",
            "src": "192.168.1.20",
            "dst": "192.168.1.10",
            "proto": "Modbus/TCP",
            "info": "Response: Trans: 1; Unit: 1, Func: 3: Read Holding Registers",
            "len": "71 B",
            "wire": {
              "tcp": {
                "sport": 502,
                "dport": 51874,
                "flags": "PA",
                "data": {
                  "modbus": {
                    "tid": 1,
                    "fn": 3,
