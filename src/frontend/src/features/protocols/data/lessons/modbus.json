  "steps": [
    {
      "title": "Port 502",
      "desc": "A TCP connection to the PLC",
      "detail": "A PLC (programmable logic controller) runs a small pumping station: it reads the sensors and switches the pumps. An engineer’s laptop on the plant network talks to it in Modbus/TCP, so it opens a TCP connection to port 502. In Modbus terms the laptop is the client and the PLC the server.",
      "facts": [
        [
          "PLC",
          "192.168.1.20"
        ],
        [
          "Port",
          "TCP 502"
        ],
        [
          "Roles",
          "Client asks, server answers"
        ]
      ],
