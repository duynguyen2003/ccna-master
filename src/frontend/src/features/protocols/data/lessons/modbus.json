  "overview": {
    "full": "Modbus/TCP, for industrial control",
    "description": "Modbus is one of the oldest and most widely used protocols in industrial control (OT, operational technology): PLCs, sensors, motor drives and meters in factories, water works and buildings speak it. A client reads and writes numbered registers and coils on a device. Modbus/TCP carries the same small messages over TCP port 502, with no login and no encryption.",
    "facts": [
      [
        "Layer",
        "Application (Layer 7)"
      ],
      [
        "Port",
        "TCP 502"
      ],
      [
        "Since",
        "1979, by Modicon"
      ],
      [
        "Data",
        "16-bit registers, on/off coils"
      ],
      [
        "Security",
        "None built in"
      ],
      [
        "Defined In",
        "Modbus.org specifications"
      ]
    ]
  },
  "outro": {
    "title": "Pump running",
    "desc": "Simple, and wide open",
    "text": "The laptop read four registers, changed a setpoint and started a pump, each with a 12-byte request and a short answer. No message carried a password and none was encrypted: Modbus trusts whoever can reach it, so the network around it has to do the protecting. Press REPLAY to watch it again.",
    "facts": [
      [
        "Messages",
        "4 requests, 4 answers"
      ],
      [
        "Biggest",
        "17 bytes (the read answer)"
      ],
      [
        "Login",
        "None"
      ],
      [
        "Protect with",
        "Separate networks"
      ]
    ]
  },
