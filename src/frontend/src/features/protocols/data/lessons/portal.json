  "steps": [
    {
      "title": "Joined, Offline",
      "desc": "An address, but no way out",
      "detail": "The laptop has joined the hotel’s Wi-Fi, which has no password, and got an address from the router by DHCP. The router answers the laptop itself and passes on its DNS lookups, but drops anything else bound for the internet until the guest has logged in. (An open network also means anyone nearby can read whatever isn’t protected by HTTPS.)",
      "facts": [
        [
          "Address",
          "192.168.1.10 (by DHCP)"
        ],
        [
          "Wi-Fi password",
          "None (open network)"
        ],
        [
          "Internet",
          "Blocked until you log in"
        ]
      ],
      "events": [
        {
          "type": "show",
          "nodes": [
            "router"
          ],
          "frame": "local"
        },
        {
          "type": "note",
          "at": "client",
          "text": "CONNECTED, NO INTERNET YET",
          "tone": "amber"
        }
      ]
    },
    {
      "title": "Internet Check",
      "desc": "Windows checks a test page",
      "detail": "After joining any network, Windows looks up www.msftconnecttest.com (the router passes the lookup on) and asks it for /connecttest.txt over plain HTTP; the right answer is the text \"Microsoft Connect Test\". The router catches the connection and answers the handshake itself, in the test server’s name. The laptop can’t tell yet.",
