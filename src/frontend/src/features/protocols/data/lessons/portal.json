  "overview": {
    "full": "Wi-Fi login pages",
    "description": "Hotels, cafés, airports and trains often put a login page in front of their Wi-Fi. Until you accept the terms (or pay), the router lets nothing out to the internet. It catches your device’s first plain HTTP request and answers it with a redirect to its own page; your device notices because a test page it knows comes back wrong.",
    "facts": [
      [
        "Where",
        "Hotels, cafés, airports"
      ],
      [
        "How",
        "Catches plain HTTP requests"
      ],
      [
        "Noticed by",
        "Your system’s test page"
      ],
      [
        "Logging in",
        "Lets your MAC address through"
      ],
      [
        "Newer way",
        "DHCP option 114 (RFC 8910)"
      ],
      [
        "Described In",
        "RFC 8952"
      ]
    ]
  },
  "outro": {
    "title": "Online",
    "desc": "Noticed, logged in, let through",
    "text": "Windows asked a test page for an answer it knows and got a redirect instead, so it knew a portal was in the way and opened the login page. Once the terms were accepted, the router let the laptop through, and the same check came back right. Press REPLAY to watch it again.",
    "facts": [
      [
        "Noticed by",
        "A plain HTTP test page"
      ],
      [
        "Faked by",
        "The router (TTL 64)"
      ],
      [
        "Let through",
        "The laptop’s MAC address"
      ],
      [
        "Open Wi-Fi",
        "Use HTTPS, or a VPN"
      ]
    ]
  },
