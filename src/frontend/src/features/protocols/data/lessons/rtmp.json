  "overview": {
    "full": "Real-Time Messaging Protocol",
    "description": "RTMP is how most streamers send live video to a platform: OBS and other apps push it to an ingest server, which turns it into streams for viewers. Made for Flash, it outlived Flash as the way to upload. Everything shares one TCP connection: commands, audio and video, cut into chunks.",
    "facts": [
      [
        "Layer",
        "Application (Layer 7)"
      ],
      [
        "Port",
        "TCP 1935"
      ],
      [
        "Carries",
        "H.264 video, AAC audio"
      ],
      [
        "Commands",
        "Encoded in AMF0"
      ],
      [
        "Secure version",
        "RTMPS, over TLS"
      ],
      [
        "Defined In",
        "Adobe specification (2012)"
      ]
    ]
  },
  "outro": {
    "title": "Live",
    "desc": "Connected, published, streamed",
    "text": "OBS shook hands with the ingest server, connected to its live app, got stream 1 and published to it with the stream key. The video and audio then flowed in chunks over the same TCP connection until the streamer stopped. Press REPLAY to watch it again.",
    "facts": [
      [
        "Connection",
        "One TCP, port 1935"
      ],
      [
        "Stream",
        "ID 1"
      ],
      [
        "Chunks",
        "Up to 4,096 bytes"
      ],
      [
        "Encryption",
        "None: RTMPS adds TLS"
      ]
    ]
  },
