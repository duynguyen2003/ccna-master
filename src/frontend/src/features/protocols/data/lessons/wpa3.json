    },
    {
      "title": "SAE Confirm",
      "desc": "Proof, without the password",
      "detail": "Each side now works out the shared key and sends a confirm, a value only someone with the right password could produce. Recording all four SAE frames doesn’t let an attacker test guesses at home: every guess takes a live exchange with the access point, which can slow them down or shut them out.",
      "facts": [
        [
          "Result",
          "A new key (PMK) each time"
        ],
        [
          "Guessing",
          "Live only, never offline"
        ],
        [
          "Password leaks",
          "Past traffic stays safe"
        ]
      ],
