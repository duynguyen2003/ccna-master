  "overview": {
    "full": "Wi-Fi Protected Access 3",
    "description": "WPA3 is the current Wi-Fi security standard. Its Personal mode keeps the simple shared password but changes how it is checked: SAE, a password exchange that no recording can attack offline, gives every connection a fresh key. It also makes protected management frames compulsory.",
    "facts": [
      [
        "Layer",
        "Data Link (Layer 2)"
      ],
      [
        "Password check",
        "SAE (Dragonfly)"
      ],
      [
        "Then",
        "The 4-way handshake"
      ],
      [
        "Required",
        "Protected management frames"
      ],
      [
        "Since",
        "2018"
      ],
      [
        "Defined In",
        "IEEE 802.11-2020, RFC 7664"
      ]
    ]
  },
  "outro": {
    "title": "Connected with WPA3",
    "desc": "Same password, better protocol",
    "text": "The laptop and the access point proved to each other that they know the password without giving anyone a way to test guesses offline, then made fresh keys exactly as WPA2 does. Press REPLAY to watch it again.",
    "facts": [
      [
        "SAE frames",
        "4 (commit, confirm)"
      ],
      [
        "Handshake",
        "4 EAPOL-Key frames"
      ],
      [
        "Offline guessing",
        "Not possible"
      ],
      [
        "Forged disconnects",
        "Ignored"
      ]
    ]
  },
