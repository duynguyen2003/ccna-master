    {
      "title": "SAE Commit",
      "desc": "Each side commits to the password",
      "detail": "Instead of Open System authentication, the two sides run SAE, a password exchange between equals. Each picks a random secret and sends a scalar and an element worked out from that secret and the password. The password is the same on both sides, the secrets are not, so every connection ends up with a new key.",
      "facts": [
        [
          "Group",
          "19 (256-bit curve)"
        ],
        [
          "Each sends",
          "A scalar and an element"
        ],
        [
          "Replaces",
          "Open System authentication"
        ]
      ],
      "events": [
        {
          "type": "packet",
          "from": "client",
          "to": "router",
          "color": "amber",
          "label": "COMMIT",
          "payload": [
