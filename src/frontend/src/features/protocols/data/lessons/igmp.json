    {
      "title": "Pick a Channel",
      "desc": "The TV box joins a group",
      "detail": "The viewer picks channel 1. Each channel is a multicast group, here 233.252.0.1, and the TV box sends an IGMP Membership Report to that address: I want this group. The switch listens in (IGMP snooping), notes port 2, and passes the report to the router alone.",
      "facts": [
        [
          "Channel 1",
          "233.252.0.1"
        ],
        [
          "Message",
          "Membership Report"
        ],
        [
          "Switch notes",
          "Port 2 wants it"
        ]
      ],
