  "overview": {
    "full": "Internet Group Management Protocol",
    "description": "Multicast sends one stream to a group address, and the network copies it only where it’s wanted: it’s how internet providers deliver live TV channels. IGMP is how a device tells its router which groups it wants. Switches listen in (IGMP snooping), so each stream reaches only the ports that asked for it.",
    "facts": [
      [
        "Layer",
        "Network (Layer 3)"
      ],
      [
        "Carried in",
        "IP protocol 2"
      ],
      [
        "Groups",
        "224.0.0.0 to 239.255.255.255"
      ],
      [
        "Messages",
        "Report, Query, Leave"
      ],
      [
        "Version here",
        "IGMPv2"
      ],
      [
        "Defined In",
        "RFC 2236 (v3: RFC 3376)"
      ]
    ]
  },
  "outro": {
    "title": "Tuned In",
    "desc": "Joined, copied, checked, left",
    "text": "The TV box and then the laptop joined channel 1 with IGMP reports. The router joined once for the whole home, and the switch, listening in, copied the channel only to the ports that wanted it. Queries kept it flowing, and when the laptop left, the TV box’s answer kept it on. Press REPLAY to watch it again.",
    "facts": [
      [
        "Channel 1",
        "233.252.0.1"
      ],
      [
        "Upstream",
        "One stream for the home"
      ],
      [
        "Switch",
        "Copies to ports that joined"
      ],
      [
        "Checks",
        "Every 125 s"
      ]
    ]
  },
