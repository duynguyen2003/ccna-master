  "overview": {
    "full": "Post Office Protocol, version 3",
    "description": "POP3 lets a mail app download messages from a mailbox on a server. It was designed for one device that fetches mail and then removes it from the server. Commands are short words, and every reply starts with +OK or -ERR.",
    "facts": [
      [
        "Layer",
        "Application (Layer 7)"
      ],
      [
        "Ports",
        "995 (TLS), 110 (STLS)"
      ],
      [
        "Transport",
        "TCP"
      ],
      [
        "Model",
        "Download, then delete"
      ],
      [
        "Replies",
        "+OK or -ERR"
      ],
      [
        "Defined In",
        "RFC 1939"
      ]
    ]
  },
  "outro": {
    "title": "Mail downloaded",
    "desc": "And gone from the server",
    "text": "Bob’s app logged in, saw two messages, downloaded the first and deleted it, which the server carried out at QUIT. That message now lives only on this laptop, which is why POP3 suits one device and IMAP suits several.",
    "facts": [
      [
        "Messages",
        "2 waiting, 1 downloaded"
      ],
      [
        "Deleted",
        "At QUIT (UPDATE state)"
      ],
      [
        "Port",
        "995, TLS from the start"
      ],
      [
        "Best for",
        "A single device"
      ]
    ]
  },
