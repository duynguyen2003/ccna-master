  "steps": [
    {
      "title": "Client Request",
      "desc": "Browser prepares the request",
      "detail": "You open http://www.example.com. The browser will send a GET request, but packets travel to IP addresses, not names, so first it needs the server’s address. (Browsers now try https:// first; this is the plain version.)",
      "facts": [
        [
          "URL",
          "http://www.example.com/"
        ],
        [
          "Method",
          "GET"
        ],
        [
          "Next hop",
          "Router 192.168.1.1"
        ]
      ],
