  "overview": {
    "full": "Hypertext Transfer Protocol",
    "description": "HTTP is the protocol of the web: a client asks for a resource, such as an HTML page, and the server answers with a status code, headers and usually a body. Every exchange is one request and one response, written as readable text in HTTP/1.1.",
    "facts": [
      [
        "Layer",
        "Application (Layer 7)"
      ],
      [
        "Default Port",
        "80 (HTTPS: 443)"
      ],
      [
        "Transport",
        "TCP"
      ],
      [
        "Data Format",
        "Text (headers + optional body)"
      ],
      [
        "Common Methods",
        "GET, POST, PUT, DELETE, HEAD"
      ],
      [
        "Defined In",
        "RFC 9110, RFC 9112"
      ]
    ]
  },
  "outro": {
    "title": "Page delivered",
    "desc": "One request, one response",
    "text": "In under a tenth of a second the laptop looked up an address, opened a TCP connection and exchanged one HTTP request and response, all of it readable by anyone on the path. Press REPLAY to watch it again.",
    "facts": [
      [
        "Round trips",
        "3 (DNS, TCP, HTTP)"
      ],
      [
        "Total time",
        "0.094 s"
      ],
      [
        "Page size",
        "12.2 KB"
      ],
      [
        "Response",
        "Sent as 9 TCP segments"
      ]
    ]
  },
