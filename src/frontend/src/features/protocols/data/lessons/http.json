          "type": "type-url",
          "text": "www.example.com"
        },
        {
          "type": "show",
          "nodes": [
            "router"
          ],
          "frame": "local"
        }
      ]
    },
    {
      "title": "DNS Resolution",
      "desc": "Finds the server’s IP address",
      "detail": "The laptop asks the DNS server it was given by DHCP, 8.8.8.8, for the address of www.example.com. The query goes over UDP port 53 and the answer is an A record with the IPv4 address. (On a network with IPv6 it would also ask for an AAAA record.)",
      "facts": [
        [
          "Resolver",
          "8.8.8.8 (had it cached)"
        ],
        [
          "Transport",
          "UDP, port 53"
        ],
        [
          "Answer",
          "A 203.0.113.10"
        ]
      ],
      "events": [
