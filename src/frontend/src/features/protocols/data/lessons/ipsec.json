  "overview": {
    "full": "IP Security",
    "description": "IPsec protects IP packets themselves. IKEv2 sets things up: the two sides agree on algorithms, make keys and prove who they are with certificates or other credentials. Then ESP carries each packet encrypted inside another. IPsec links offices together and brings laptops into company networks, and it is built into most operating systems and firewalls.",
    "facts": [
      [
        "Layer",
        "Network (Layer 3)"
      ],
      [
        "Setup",
        "IKEv2, UDP 500"
      ],
      [
        "Behind NAT",
        "UDP 4500"
      ],
      [
        "Data",
        "ESP (IP protocol 50)"
      ],
      [
        "Identity",
        "Certificates, EAP, keys"
      ],
      [
        "Defined In",
        "RFC 7296, RFC 4303"
      ]
    ]
  },
  "outro": {
    "title": "Tunnel up",
    "desc": "IKE to set up, ESP to carry",
    "text": "Four IKE messages agreed on algorithms, found the NAT, proved both identities and set up the tunnel. After that each packet travelled whole inside ESP, encrypted and checked, and wrapped in UDP to get through the home router. Press REPLAY to watch it again.",
    "facts": [
      [
        "IKE messages",
        "4 (2 exchanges)"
      ],
      [
        "NAT traversal",
        "UDP 4500"
      ],
      [
        "ESP",
        "One SPI each way"
      ],
      [
        "Inside address",
        "10.8.0.2"
      ]
    ]
  },
