  "overview": {
    "full": "Secure Shell",
    "description": "SSH gives you an encrypted, authenticated connection to another computer, to run commands on it, copy files (SFTP, scp) or carry other connections. The server proves who it is with a host key; you prove who you are with a key pair or a password.",
    "facts": [
      [
        "Layer",
        "Application (Layer 7)"
      ],
      [
        "Port",
        "22"
      ],
      [
        "Transport",
        "TCP"
      ],
      [
        "Server proves",
        "Host key (known_hosts)"
      ],
      [
        "You prove",
        "Key pair or password"
      ],
      [
        "Defined In",
        "RFC 4251 – 4254"
      ]
    ]
  },
  "outro": {
    "title": "Logged in securely",
    "desc": "Encrypted from the key exchange on",
    "text": "The two sides agreed on algorithms, built shared keys with a post-quantum hybrid exchange, and the server proved its identity with its host key. Alice proved hers by signing with a private key that never left the laptop, then typed a command, one packet per key.",
    "facts": [
      [
        "Key exchange",
        "sntrup761 + X25519"
      ],
      [
        "Cipher",
        "ChaCha20-Poly1305"
      ],
      [
        "Login",
        "Ed25519 key, no password"
      ],
      [
        "Port",
        "22"
      ]
    ]
  },
