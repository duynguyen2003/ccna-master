  "overview": {
    "full": "Simple Mail Transfer Protocol",
    "description": "SMTP moves email: from your mail app to your provider’s server, and from that server to the recipient’s. It is a conversation of short text commands, each answered with a three-digit reply code. Reading mail is a different job, done with IMAP or POP3.",
    "facts": [
      [
        "Layer",
        "Application (Layer 7)"
      ],
      [
        "Ports",
        "465/587 submit, 25 relay"
      ],
      [
        "Transport",
        "TCP, usually with TLS"
      ],
      [
        "Commands",
        "EHLO, MAIL, RCPT, DATA"
      ],
      [
        "Replies",
        "2xx ok, 3xx go on, 4/5xx error"
      ],
      [
        "Defined In",
        "RFC 5321, RFC 6409"
      ]
    ]
  },
  "outro": {
    "title": "Mail delivered",
    "desc": "Two hops, one message",
    "text": "Alice’s app handed the message to her provider over an encrypted, logged-in connection. The provider found Bob’s mail server in DNS and relayed it there, upgrading that link to TLS. It now waits in Bob’s mailbox until he reads it with IMAP or POP3.",
    "facts": [
      [
        "Hops",
        "Laptop → provider → Bob’s"
      ],
      [
        "Submission",
        "Port 465, TLS, login"
      ],
      [
        "Relay",
        "Port 25, STARTTLS"
      ],
      [
        "Checks at Bob’s",
        "SPF, DKIM, DMARC"
      ]
    ]
  },
