  "overview": {
    "full": "Forward proxy, and CONNECT for HTTPS",
    "description": "A forward proxy fetches web pages on your behalf. Companies and schools use one to filter sites, keep copies of popular pages and log what goes out; the sites you visit see the proxy, not you. Plain HTTP passes through it in the clear. For HTTPS the browser asks the proxy for a tunnel, and the encrypted connection runs through it unread.",
    "facts": [
      [
        "Layer",
        "Application (Layer 7)"
      ],
      [
        "Common ports",
        "8080, 3128"
      ],
      [
        "http:// pages",
        "Fetched by the proxy"
      ],
      [
        "https:// pages",
        "Tunnelled with CONNECT"
      ],
      [
        "Used for",
        "Filtering, caching, logging"
      ],
      [
        "Defined In",
        "RFC 9110 (CONNECT: §9.3.6)"
      ]
    ]
  },
  "outro": {
    "title": "Two ways through",
    "desc": "Fetched for you, or tunnelled",
    "text": "For the plain page, the proxy did the work: it read the request, fetched the page on its own connection and could have kept, changed or refused it. For HTTPS it only opened a tunnel and copied encrypted bytes, knowing nothing but the site’s name. Press REPLAY to watch it again.",
    "facts": [
      [
        "Server sees",
        "The proxy (192.0.2.80)"
      ],
      [
        "Plain HTTP",
        "The proxy reads it all"
      ],
      [
        "HTTPS",
        "Name and sizes only"
      ],
      [
        "DNS for the site",
        "Done by the proxy"
      ]
    ]
  },
