  "overview": {
    "full": "RADIUS and 802.1X (Enterprise Wi-Fi)",
    "description": "At home everyone shares one Wi-Fi password. Offices, universities and eduroam use WPA2- or WPA3-Enterprise instead: each person or device logs in with its own account or certificate, checked by a RADIUS server. The access point knows no passwords. It passes the login, a series of EAP messages, between the laptop and the server, and lets the laptop in only when the server says yes.",
    "facts": [
      [
        "Layer",
        "Data Link (Layer 2)"
      ],
      [
        "Standard",
        "IEEE 802.1X"
      ],
      [
        "Login",
        "EAP (here EAP-TLS)"
      ],
      [
        "Checked by",
        "RADIUS, UDP 1812"
      ],
      [
        "Keys",
        "Different for every login"
      ],
      [
        "Defined In",
        "RFC 2865, 3579, 5216"
      ]
    ]
  },
  "outro": {
    "title": "Let in",
    "desc": "Its own login, its own keys",
    "text": "The laptop proved who it was with its certificate. The RADIUS server checked it and told the access point to let it in, on VLAN 20, with a key for this login alone. The access point never saw a password: it only passed the messages on. Press REPLAY to watch it again.",
    "facts": [
      [
        "Login",
        "EAP-TLS (certificates)"
      ],
      [
        "Messages",
        "17, then the 4-way handshake"
      ],
      [
        "VLAN",
        "20 (staff)"
      ],
      [
        "A user leaves",
        "Disable one account"
      ]
    ]
  },
