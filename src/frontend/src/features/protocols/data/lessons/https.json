  "steps": [
    {
      "title": "Secure Request",
      "desc": "Browser asks for https://",
      "detail": "You type https://www.example.com. The “s” tells the browser to protect the connection with TLS, on port 443 by default. Before it can connect at all, it still has to find the server’s IP address.",
      "facts": [
        [
          "URL",
          "https://www.example.com/"
        ],
        [
          "Port",
          "443"
        ],
        [
          "Next hop",
          "Router 192.168.1.1"
        ]
      ],
      "events": [
        {
          "type": "type-url",
          "text": "https://www.example.com",
          "secure": true
        },
        {
          "type": "show",
          "nodes": [
            "router"
          ],
          "frame": "local"
        }
      ]
    },
    {
      "title": "DNS Lookup",
      "desc": "Same lookup as HTTP, not encrypted",
      "detail": "The lookup is exactly the same as for plain HTTP: a query to 8.8.8.8 over UDP port 53. It is not encrypted, so anyone on the path can see which name you asked for, unless the browser uses DNS over HTTPS.",
      "facts": [
        [
          "Resolver",
          "8.8.8.8 (had it cached)"
        ],
        [
          "Encrypted",
          "No (plain DNS)"
        ],
        [
          "Answer",
          "A 203.0.113.10"
        ]
      ],
      "events": [
