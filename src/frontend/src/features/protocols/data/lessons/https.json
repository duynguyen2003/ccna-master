    {
      "title": "TLS Handshake",
      "desc": "Agrees on keys, checks the certificate",
      "detail": "The browser offers ciphers and key shares, including a post-quantum hybrid. The server picks it and sends its own share, then its certificate, already encrypted. The browser checks it against authorities it trusts.",
      "facts": [
        [
          "Version",
          "TLS 1.3"
        ],
        [
          "Key exchange",
          "X25519MLKEM768 (hybrid)"
        ],
        [
          "Server name",
          "Sent in clear (SNI)"
        ]
