  "overview": {
    "full": "HTTP Secure",
    "description": "HTTPS is HTTP sent through an encrypted TLS connection. TLS proves the server is who it claims to be with a certificate, agrees on fresh encryption keys, and then protects every request and response from being read or changed on the way.",
    "facts": [
      [
        "Layer",
        "Application (HTTP over TLS)"
      ],
      [
        "Default Port",
        "443"
      ],
      [
        "Transport",
        "TCP"
      ],
      [
        "Security",
        "TLS 1.3 (1.2 still common)"
      ],
      [
        "Proves",
        "Server identity (certificate)"
      ],
      [
        "Defined In",
        "RFC 9110, RFC 8446"
      ]
    ]
  },
  "outro": {
    "title": "Secure page delivered",
    "desc": "Encrypted, except the lookup",
    "text": "The browser looked up the address in plain DNS, opened a TCP connection, checked the server’s certificate and agreed on keys in one round trip. Every HTTP byte after that travelled encrypted. Press REPLAY to watch it again.",
    "facts": [
      [
        "Round trips",
        "4 (DNS, TCP, TLS, HTTP)"
      ],
      [
        "Total time",
        "0.130 s"
      ],
      [
        "Cipher",
        "TLS_AES_128_GCM_SHA256"
      ],
      [
        "Still visible",
        "IPs, server name, sizes"
      ]
    ]
  },
