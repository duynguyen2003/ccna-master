          "row": {
            "time": "3.017s",
            "src": "203.0.113.10",
            "dst": "192.168.1.10",
            "proto": "ICMP",
            "info": "Echo (ping) reply id=0x0001, seq=4, ttl=52",
            "len": "74 B",
            "wire": {
              "icmp": {
                "type": 0,
