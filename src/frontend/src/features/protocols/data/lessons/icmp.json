    {
      "title": "Unreachable",
      "desc": "Nothing listening on that port",
      "detail": "An app sends a UDP datagram to port 9999, where nothing is listening. The server can’t deliver it, so it replies with Destination Unreachable, code 3 (port unreachable), quoting the start of the datagram. Many firewalls drop such packets silently instead.",
      "facts": [
        [
          "Type, code",
          "3, 3 (port unreachable)"
        ],
        [
          "Other codes",
          "0 net, 1 host, 4 too big"
        ],
        [
          "Firewalls",
          "Often silent instead"
        ]
      ],
      "events": [
        {
          "type": "packet",
          "from": "client",
          "to": "web",
          "color": "amber",
          "label": "UDP",
          "payload": [
