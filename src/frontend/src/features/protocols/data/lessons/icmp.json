  ],
  "overview": {
    "full": "Internet Control Message Protocol",
    "description": "ICMP is how the network reports back: a router says a packet’s time ran out, a server says nothing is listening on a port. Tools like ping and traceroute are built from these messages. It travels inside IP but carries no application data.",
    "facts": [
      [
        "Layer",
        "Network (Layer 3)"
      ],
      [
        "Carried in",
        "IP (protocol 1)"
      ],
      [
        "Messages",
        "A type and a code"
      ],
      [
        "Tools",
        "ping, tracert / traceroute"
      ],
      [
        "Often",
        "Filtered by firewalls"
      ],
      [
        "Defined In",
        "RFC 792 (IPv6: RFC 4443)"
      ]
    ]
  },
  "outro": {
    "title": "The network answered",
    "desc": "Replies, expiries and errors",
    "text": "An echo request measured the round trip, packets with a small TTL made each router on the path identify itself, and a closed port was reported straight back. Press REPLAY to watch it again.",
    "facts": [
      [
        "Round trip",
        "34 ms"
      ],
      [
        "Path",
        "12 routers, server at hop 13"
      ],
      [
        "Types used",
        "8, 0, 11 and 3"
      ],
      [
        "Reply TTL",
        "52 (64 − 12 routers)"
      ]
    ]
  },
  "start": {
    "nodes": [
      "client"
    ],
    "frame": "client"
  },
  "steps": [
    {
      "title": "Ping",
      "desc": "Echo request",
      "detail": "“ping -n 1 203.0.113.10” sends one ICMP echo request (plain ping sends four, a second apart): type 8, code 0, with an identifier, a sequence number and 32 bytes of filler. The server’s system answers by itself, no application needed.",
      "facts": [
        [
          "Type, code",
          "8, 0 (echo request)"
        ],
        [
          "Data",
          "32 bytes (Windows)"
        ],
        [
          "TTL",
          "128"
        ]
      ],
      "events": [
        {
          "type": "show",
          "nodes": [
            "router",
            "internet",
            "web"
          ],
          "frame": "full"
        },
        {
          "type": "packet",
          "from": "client",
          "to": "web",
          "color": "amber",
          "label": "ECHO REQUEST",
          "payload": [
            "type 8 · seq 1",
            "32 bytes of data"
          ],
          "row": {
            "time": "0.000s",
            "src": "192.168.1.10",
            "dst": "203.0.113.10",
            "proto": "ICMP",
            "info": "Echo (ping) request id=0x0001, seq=1, ttl=128",
            "len": "74 B",
            "wire": {
              "icmp": {
                "type": 8,
                "code": 0,
                "id": 1,
                "seq": 1,
                "data": "abcdefghijklmnopqrstuvwabcdefghi"
              }
            }
          }
        }
      ]
    },
    {
      "title": "Echo Reply",
      "desc": "Round-trip time",
      "detail": "The server sends back an echo reply, type 0, with the same identifier, sequence number and data. Ping prints the time it took and the TTL the reply arrived with: “bytes=32 time=34ms TTL=52”.",
      "facts": [
        [
          "Type, code",
          "0, 0 (echo reply)"
        ],
        [
          "Round trip",
          "34 ms"
        ],
        [
          "TTL on arrival",
          "52 (64 − 12 routers)"
        ]
      ],
      "events": [
        {
          "type": "packet",
          "from": "web",
          "to": "client",
          "color": "green",
          "label": "ECHO REPLY",
          "payload": [
            "type 0 · seq 1",
            "same 32 bytes back"
          ],
          "row": {
            "time": "0.017s",
            "src": "203.0.113.10",
            "dst": "192.168.1.10",
            "proto": "ICMP",
            "info": "Echo (ping) reply id=0x0001, seq=1, ttl=52",
            "len": "74 B",
            "wire": {
              "icmp": {
                "type": 0,
                "code": 0,
                "id": 1,
                "seq": 1,
                "data": "abcdefghijklmnopqrstuvwabcdefghi"
              }
            }
          }
        },
        {
          "type": "note",
          "at": "client",
          "text": "TIME=34MS TTL=52",
          "tone": "green"
        }
      ]
    },
    {
      "title": "TTL 1",
      "desc": "The first router answers",
      "detail": "“ping -n 1 -i 1” sends the same request with a TTL of 1. The home router lowers it to 0, so it must drop the packet, and it sends back a Time Exceeded message from its own address: “Reply from 192.168.1.1: TTL expired in transit.”",
      "facts": [
        [
          "Sent with",
          "TTL 1"
        ],
        [
          "Dropped by",
          "Router 192.168.1.1"
        ],
        [
          "Type, code",
          "11, 0 (time exceeded)"
        ]
      ],
      "events": [
        {
          "type": "packet",
          "from": "client",
          "to": "router",
          "color": "amber",
          "label": "TTL 1",
          "payload": [
            "echo request",
            "expires at the first router"
          ],
          "row": {
            "time": "1.000s",
            "src": "192.168.1.10",
            "dst": "203.0.113.10",
            "proto": "ICMP",
            "info": "Echo (ping) request id=0x0001, seq=2, ttl=1",
            "len": "74 B",
            "wire": {
              "icmp": {
                "type": 8,
                "code": 0,
                "id": 1,
                "seq": 2,
                "data": "abcdefghijklmnopqrstuvwabcdefghi"
              },
              "ttl": 1
            }
          }
        },
        {
          "type": "packet",
          "from": "router",
          "to": "client",
          "color": "slate",
          "label": "TIME EXCEEDED",
          "payload": [
            "type 11 · from 192.168.1.1",
            "quotes the dropped header"
          ],
          "row": {
            "time": "1.001s",
            "src": "192.168.1.1",
            "dst": "192.168.1.10",
            "proto": "ICMP",
            "info": "Time-to-live exceeded (in transit)",
            "len": "102 B",
            "wire": {
              "icmp": {
                "type": 11,
                "code": 0,
                "quote": -1,
                "ttl": 1,
                "quoteBytes": "all"
              }
            }
          }
        }
      ]
    },
    {
      "title": "TTL 2",
      "desc": "The next router answers",
      "detail": "With “-i 2”, the home router lowers the TTL to 1 and forwards it. The first router at the internet provider lowers it to 0 and reports back from 198.51.100.1. The home router translates the report back to the laptop like any reply.",
      "facts": [
        [
          "Sent with",
          "TTL 2"
        ],
        [
          "Dropped by",
          "ISP router 198.51.100.1"
        ],
        [
          "Type, code",
          "11, 0 (time exceeded)"
        ]
      ],
      "events": [
        {
          "type": "packet",
          "from": "client",
          "to": "internet",
          "color": "amber",
          "label": "TTL 2",
          "payload": [
            "echo request",
            "expires at the second router"
          ],
          "row": {
            "time": "2.000s",
            "src": "192.168.1.10",
            "dst": "203.0.113.10",
            "proto": "ICMP",
            "info": "Echo (ping) request id=0x0001, seq=3, ttl=2",
            "len": "74 B",
            "wire": {
              "icmp": {
                "type": 8,
                "code": 0,
                "id": 1,
                "seq": 3,
                "data": "abcdefghijklmnopqrstuvwabcdefghi"
              },
              "ttl": 2
            }
          }
        },
        {
          "type": "note",
          "at": "internet",
          "text": "HOP 2 · 198.51.100.1",
          "tone": "navy"
        },
        {
          "type": "packet",
          "from": "internet",
          "to": "client",
          "color": "slate",
          "label": "TIME EXCEEDED",
          "payload": [
            "type 11 · from 198.51.100.1",
            "quotes the dropped header"
          ],
          "row": {
            "time": "2.005s",
            "src": "198.51.100.1",
            "dst": "192.168.1.10",
            "proto": "ICMP",
            "info": "Time-to-live exceeded (in transit)",
            "len": "70 B",
            "wire": {
              "icmp": {
                "type": 11,
                "code": 0,
                "quote": -1,
                "ttl": 1,
                "quoteBytes": 8
              }
            }
          }
        }
      ]
    },
    {
      "title": "That’s Traceroute",
      "desc": "TTL 1, 2, 3 … until it arrives",
      "detail": "tracert automates this: it raises the TTL by one each time, sends three probes per hop and lists who reports back. Hops 3 to 12 work the same way, and with TTL 13 the request finally reaches the server, which replies normally.",
      "facts": [
        [
          "Hops",
          "12 routers, then the server"
        ],
        [
          "Per hop",
          "3 probes"
        ],
        [
          "On Linux",
          "traceroute sends UDP"
        ]
      ],
      "events": [
        {
          "type": "packet",
          "from": "client",
          "to": "web",
          "color": "amber",
          "label": "TTL 13",
          "payload": [
            "echo request",
            "enough hops to arrive"
          ],
          "row": {
            "time": "3.000s",
            "src": "192.168.1.10",
            "dst": "203.0.113.10",
            "proto": "ICMP",
            "info": "Echo (ping) request id=0x0001, seq=4, ttl=13",
            "len": "74 B",
            "wire": {
              "icmp": {
                "type": 8,
                "code": 0,
                "id": 1,
                "seq": 4,
                "data": "abcdefghijklmnopqrstuvwabcdefghi"
