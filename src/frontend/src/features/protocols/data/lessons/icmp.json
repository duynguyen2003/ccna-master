          "row": {
            "time": "4.000s",
            "src": "192.168.1.10",
            "dst": "203.0.113.10",
            "proto": "UDP",
            "info": "52500 → 9999 Len=18",
            "len": "60 B",
            "wire": {
              "udp": {
                "sport": 52500,
                "dport": 9999,
                "data": {
                  "ascii": "hello, anyone here",
                  "name": "App data",
                  "note": "What the app sent; nothing on the server is listening for it."
                }
              }
            }
          }
