  "overview": {
    "full": "File Transfer Protocol",
    "description": "FTP moves files between a client and a server. It is unusual in using two TCP connections: one for commands and replies, and a fresh one for each file or listing. It dates from the early 1970s and sends everything, passwords included, as plain text.",
    "facts": [
      [
        "Layer",
        "Application (Layer 7)"
      ],
      [
        "Ports",
        "21 control, data varies"
      ],
      [
        "Connections",
        "Control + one per transfer"
      ],
      [
        "Encryption",
        "None (plain text)"
      ],
      [
        "Safer options",
        "SFTP, or FTPS (FTP + TLS)"
      ],
      [
        "Defined In",
        "RFC 959"
      ]
    ]
  },
  "outro": {
    "title": "File downloaded",
    "desc": "Two connections, no encryption",
    "text": "Commands went over the control connection, the file over its own data connection, and closing that connection marked the end of the file. Anyone on the path could have read the password and the file, which is why SFTP or FTPS is used today.",
    "facts": [
      [
        "Connections",
        "2 (control + data)"
      ],
      [
        "File",
        "4,000 bytes, 3 segments"
      ],
      [
        "Password",
        "Sent in plain text"
      ],
      [
        "Use instead",
        "SFTP or FTPS"
      ]
    ]
  },
