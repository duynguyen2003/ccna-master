      ]
    },
    {
      "title": "Ready, No DHCP",
      "desc": "And no NAT either",
      "detail": "The laptop is on the internet with its own global address, and no NAT changes it on the way: the address a website sees is the laptop’s. The home router’s firewall still turns away connections nobody inside asked for. Networks that want to hand out addresses centrally can use DHCPv6 instead.",
      "facts": [
        [
          "NAT",
          "Not needed"
        ],
        [
          "Incoming",
          "Blocked by the firewall"
        ],
        [
          "DHCPv6",
          "Optional (flags M, O)"
        ]
      ],
      "events": [
        {
          "type": "note",
          "at": "client",
          "text": "ONLINE OVER IPv6",
          "tone": "green"
        }
      ]
    }
