    {
      "title": "Switch Protocols",
      "desc": "101: from now on, WebSocket",
      "detail": "The server answers 101 Switching Protocols. Its Sec-WebSocket-Accept is the key with a fixed string added, hashed with SHA-1 and written in base64: proof that it understood the request. It didn’t take up compression, so messages go as plain text. HTTP is finished on this connection; from now on both sides send WebSocket frames.",
      "facts": [
        [
          "Status",
          "101 Switching Protocols"
        ],
        [
          "Accept",
          "SHA-1 of the key + a fixed string"
        ],
        [
          "Compression",
          "Offered, not taken"
        ]
      ],
