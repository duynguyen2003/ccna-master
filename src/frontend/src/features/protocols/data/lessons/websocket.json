  "overview": {
    "full": "The WebSocket Protocol",
    "description": "A WebSocket keeps one connection open between a web page and a server, so either side can send a message at any moment: chat, live scores, games, shared documents. It starts as an ordinary HTTP request asking to upgrade; after that, messages travel in small frames with a header of just a few bytes.",
    "facts": [
      [
        "Layer",
        "Application (Layer 7)"
      ],
      [
        "Ports",
        "80 (ws://), 443 (wss://)"
      ],
      [
        "Starts as",
        "An HTTP request (Upgrade)"
      ],
      [
        "Then",
        "Frames both ways, any time"
      ],
      [
        "Frame header",
        "2–14 bytes"
      ],
      [
        "Defined In",
        "RFC 6455"
      ]
    ]
  },
  "outro": {
    "title": "Connection closed",
    "desc": "One request, then messages",
    "text": "One HTTP request turned an ordinary TCP connection into a two-way channel. After that every message cost a few bytes of header, and the server could send whenever it had something to say. Press REPLAY to watch it again.",
    "facts": [
      [
        "Handshake",
        "GET with Upgrade, then 101"
      ],
      [
        "Smallest frame",
        "2 bytes (a ping)"
      ],
      [
        "Server push",
        "Any time, unasked"
      ],
      [
        "Real sites",
        "wss:// (inside TLS)"
      ]
    ]
  },
