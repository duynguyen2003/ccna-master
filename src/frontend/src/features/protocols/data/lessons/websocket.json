    {
      "title": "Live Updates",
      "desc": "Small frames, from either side",
      "detail": "You send \"Hello\": a 2-byte header, a 4-byte masking key and the 5 masked bytes, 11 bytes in all instead of a whole HTTP request. Seconds later the server pushes Bob’s message without being asked: the connection is still open, so it can. Frames from the browser are always masked; frames from the server never are.",
      "facts": [
        [
          "You send",
          "\"Hello\" (11 bytes)"
        ],
        [
          "Server pushes",
          "\"bob: hi there\""
        ],
        [
          "Masked",
          "From the browser only"
        ]
      ],
