    {
      "title": "Ask to Upgrade",
      "desc": "An HTTP request with Upgrade: websocket",
      "detail": "The browser sends an HTTP GET with Upgrade: websocket and Connection: Upgrade. Sec-WebSocket-Key is 16 random bytes written in base64, which the server has to answer correctly. The browser also offers to compress messages (permessage-deflate).",
      "facts": [
        [
          "Request",
          "GET /chat"
        ],
        [
          "Asks for",
          "Upgrade: websocket"
        ],
