  "overview": {
    "full": "Dynamic Host Configuration Protocol",
    "description": "DHCP hands a device everything it needs to use a network: an IP address, the subnet mask, the router to send traffic through and the DNS servers to ask. Addresses are leased for a set time and renewed while the device stays on the network.",
    "facts": [
      [
        "Layer",
        "Application (Layer 7)"
      ],
      [
        "Ports",
        "UDP 67 (server), 68 (client)"
      ],
      [
        "Hands out",
        "IP, mask, gateway, DNS"
      ],
      [
        "Exchange",
        "Discover, Offer, Request, Ack"
      ],
      [
        "Lease",
        "Renewed at half its time"
      ],
      [
        "Defined In",
        "RFC 2131, RFC 2132"
      ]
    ]
  },
  "outro": {
    "title": "On the network",
    "desc": "Leased, and kept up to date",
    "text": "Four messages took the laptop from no address to a working configuration, and halfway through the 24-hour lease it renewed it with a direct request to the router. Press REPLAY to watch it again.",
    "facts": [
      [
        "Messages",
        "4 to join, 2 per renewal"
      ],
      [
        "Address",
        "192.168.1.10/24"
      ],
      [
        "Lease",
        "24 h, renewed at 12 h"
      ],
      [
        "Ports",
        "UDP 68 → 67"
      ]
    ]
  },
