  "steps": [
    {
      "title": "No Address Yet",
      "desc": "The laptop joins the network",
      "detail": "The laptop has just connected. It has a MAC address built in, but no IP address, no gateway and no DNS server, so it can’t talk to anything beyond its own network yet. It asks for them with DHCP.",
      "facts": [
        [
          "IP address",
          "None (uses 0.0.0.0)"
        ],
        [
          "MAC address",
          "00:00:5e:00:53:10"
        ],
        [
          "Needs",
          "IP, mask, gateway, DNS"
        ]
