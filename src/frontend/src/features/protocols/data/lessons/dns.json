  "overview": {
    "full": "Domain Name System",
    "description": "DNS turns names like www.example.com into the IP addresses computers use to reach each other. No single server knows every name: the system is a hierarchy of servers, and answers are cached along the way so most lookups never have to go far.",
    "facts": [
      [
        "Layer",
        "Application (Layer 7)"
      ],
      [
        "Port",
        "53, UDP (TCP if large)"
      ],
      [
        "Turns",
        "Names into IP addresses"
      ],
      [
        "Hierarchy",
        "Root → TLD → authoritative"
      ],
      [
        "Caching",
        "For each record’s TTL"
      ],
      [
        "Defined In",
        "RFC 1034, RFC 1035"
      ]
    ]
  },
  "outro": {
    "title": "Name resolved",
    "desc": "And remembered for an hour",
    "text": "Starting from an empty cache, the resolver walked from the root to .com to example.com’s own server, then answered the laptop. Until the TTL runs out, the next lookup for this name is answered straight from a cache. Press REPLAY to watch it again.",
    "facts": [
      [
        "Queries",
        "4 (laptop 1, resolver 3)"
      ],
      [
        "Total time",
        "0.094 s"
      ],
      [
        "Transport",
        "UDP, port 53"
      ],
      [
        "Cached for",
        "3600 s (TTL)"
      ]
    ]
  },
