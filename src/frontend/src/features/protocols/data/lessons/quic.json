  "overview": {
    "full": "HTTP/3 over QUIC",
    "description": "QUIC is a newer transport that runs over UDP and has TLS 1.3 built in. Its first packets do the transport and the encryption handshakes together, so a page request can leave after one round trip. It carries many streams at once, so one lost packet doesn’t hold up the rest, and it survives a change of network. HTTP/3 is HTTP running over QUIC.",
    "facts": [
      [
        "Layer",
        "Transport (Layer 4)"
      ],
      [
        "Runs over",
        "UDP, port 443"
      ],
      [
        "Encryption",
        "TLS 1.3, always"
      ],
      [
        "Handshake",
        "1 round trip (0 when returning)"
      ],
      [
        "Streams",
        "Many, independent"
      ],
      [
        "Defined In",
        "RFC 9000, RFC 9114"
      ]
    ]
  },
  "outro": {
    "title": "Page delivered",
    "desc": "One round trip, then the request",
    "text": "QUIC folded the transport and TLS handshakes into one round trip, so the request left 36 ms after the first packet; over TCP and TLS it would have waited twice as long. Everything after the first packets was encrypted, even most of each packet’s header. Press REPLAY to watch it again.",
    "facts": [
      [
        "Round trips",
        "1 before the request (TCP + TLS: 2)"
      ],
      [
        "Datagrams",
        "10"
      ],
      [
        "Transport",
        "UDP, port 443"
      ],
      [
        "Lost packet",
        "Holds up one stream only"
      ]
    ]
  },
