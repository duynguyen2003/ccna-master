    {
      "title": "New Network",
      "desc": "Known by ID, not by address",
      "detail": "A QUIC connection is known by its connection IDs, not by addresses and ports. If the laptop moves from Wi-Fi to a phone’s hotspot, its address changes but the connection carries on: the server checks the new path and continues. And on the next visit the browser can send its request in its very first packets (0-RTT).",
      "facts": [
        [
          "Known by",
          "Connection ID"
        ],
        [
          "New address",
          "The connection carries on"
        ],
        [
          "Next visit",
          "0-RTT: request at once"
        ]
      ],
      "events": [
        {
          "type": "note",
          "at": "client",
          "text": "SAME CONNECTION ON ANY NETWORK",
          "tone": "navy"
        }
