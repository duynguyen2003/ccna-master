  "overview": {
    "full": "TLS (SSL) offloading",
    "description": "A reverse proxy stands in front of a website’s servers: visitors connect to it, and it passes their requests on to an app server behind it. It can spread the load over many servers, keep copies of pages and turn away attacks. Often it also does the TLS work, decrypting HTTPS at the edge so the servers behind it speak plain HTTP. That is SSL (or TLS) offloading.",
    "facts": [
      [
        "Layer",
        "Application (Layer 7)"
      ],
      [
        "Visitors reach",
        "The proxy, never the app"
      ],
      [
        "TLS ends",
        "At the proxy (offloading)"
      ],
      [
        "Inside",
        "Plain HTTP (or TLS again)"
      ],
      [
        "Adds",
        "X-Forwarded-For, -Proto"
      ],
      [
        "For example",
        "nginx, HAProxy, cloud LBs"
      ]
    ]
  },
  "outro": {
    "title": "Served from the edge",
    "desc": "Encrypted outside, plain inside",
    "text": "The laptop saw one HTTPS website. Behind it, the reverse proxy decrypted the request, asked an app server in plain HTTP over the private network and encrypted the answer for the trip back. Press REPLAY to watch it again.",
    "facts": [
      [
        "TLS",
        "Laptop ↔ proxy only"
      ],
      [
        "Inside",
        "Plain HTTP"
      ],
      [
        "App learns visitor",
        "From X-Forwarded-For"
      ],
      [
        "Certificate kept",
        "On the proxy"
      ]
    ]
  },
