    {
      "title": "TLS Ends Here",
      "desc": "Offloading: the proxy does the TLS work",
      "detail": "The request arrives encrypted, and the reverse proxy decrypts it. That is the offloading: the TLS work is done here, once, instead of on every app server. Now the proxy can read the URL, headers and cookies, and pick a server by them.",
      "facts": [
        [
          "TLS ends",
          "At the reverse proxy"
        ],
        [
          "Proxy can read",
          "URL, headers, cookies"
        ],
        [
          "Then picks",
          "An app server"
        ]
      ],
