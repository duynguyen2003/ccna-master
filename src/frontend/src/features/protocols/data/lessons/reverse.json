  "teaching": {
    "steps": [
      [
        "Cửa trước",
        "Laptop mở https://www.example.com. Địa chỉ DNS cho tên đó thuộc về reverse proxy, nơi giữ chứng chỉ của trang và làm bắt tay TLS. Không có gì cho laptop biết phía sau còn một máy chủ khác."
      ],
      [
        "TLS kết thúc ở đây",
        "Yêu cầu đến dạng mã hóa, và reverse proxy giải mã nó. Đó là giảm tải: phần việc TLS làm ở đây, một lần, thay vì trên từng máy chủ ứng dụng. Giờ proxy đọc được URL, tiêu đề và cookie, và chọn máy chủ dựa vào chúng."
      ],
      [
        "Dạng rõ",
        "Proxy chuyển yêu cầu qua mạng riêng của trung tâm dữ liệu, dưới dạng HTTP thường tới cổng 8080. Nó thêm X-Forwarded-For, địa chỉ của khách, và X-Forwarded-Proto: https, cách khách đi vào; nếu không ứng dụng chỉ thấy proxy. Ai theo dõi được mạng riêng này cũng đọc được hết."
      ],
      [
        "Ứng dụng trả lời",
        "Máy chủ ứng dụng dựng trang và trả lời proxy bằng HTTP thường: nó không bao giờ phải lo TLS hay chứng chỉ."
      ],
      [
        "Lại được mã hóa",
        "Reverse proxy mã hóa câu trả lời trong phiên TLS nó giữ với laptop và gửi đi. Nhìn từ ngoài, đó là một trang HTTPS bình thường."
      ],
      [
        "Ba lựa chọn",
        "Giảm tải, như ở đây, đơn giản và nhanh nhưng để lưu lượng bên trong đọc được. Mã hóa lại mở kết nối TLS thứ hai từ proxy tới máy chủ ứng dụng, nên bên trong cũng được mã hóa. Cho đi qua chuyển tiếp byte TLS mà không mở: chứng chỉ nằm trên máy chủ ứng dụng, và proxy chỉ chọn máy chủ được theo địa chỉ và tên trong Client Hello, không theo URL."
      ]
    ],
