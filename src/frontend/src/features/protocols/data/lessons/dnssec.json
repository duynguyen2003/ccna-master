  "overview": {
    "full": "DNS Security Extensions",
    "description": "Plain DNS answers can be forged: whoever answers first, or sits in the middle, can send a false address. DNSSEC lets a resolver check that an answer really comes from the domain’s owner. Every set of records is signed; each zone’s key is vouched for by its parent, up to the root, whose key resolvers have built in. DNSSEC proves answers are genuine; it doesn’t hide them.",
    "facts": [
      [
        "Layer",
        "Application (Layer 7)"
      ],
      [
        "Adds records",
        "RRSIG, DNSKEY, DS"
      ],
      [
        "Checked by",
        "The resolver"
      ],
      [
        "Trust anchor",
        "The root’s key (built in)"
      ],
      [
        "Hides queries",
        "No (that’s DoH)"
      ],
      [
        "Defined In",
        "RFC 4033, 4034, 4035"
      ]
    ]
  },
  "outro": {
    "title": "Answer checked",
    "desc": "A chain of signatures to the root",
    "text": "The resolver followed a chain: the address was signed by example.com’s key, that key by its key-signing key, which .com vouched for with a signed DS record, and .com’s key is vouched for by the root, whose key the resolver has built in. A forged answer would have broken the chain. Press REPLAY to watch it again.",
    "facts": [
      [
        "Signatures checked",
        "3 here (plus cached ones)"
      ],
      [
        "Algorithm",
        "ECDSA P-256 (13)"
      ],
      [
        "Laptop sees",
        "The AD flag"
      ],
      [
        "Forged answer",
        "Fails the check"
      ]
    ]
  },
