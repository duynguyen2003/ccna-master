    {
      "title": "Signed Answer",
      "desc": "An RRSIG comes with the A record",
      "detail": "The resolver already knows example.com’s name server from earlier lookups. That server sends the address with an RRSIG record: a signature over the A record, made with the zone’s private key. The RRSIG says which key signed it (key 47362, the zone-signing key) and when the signature expires. To check it the resolver needs that key.",
      "facts": [
        [
          "Answer",
          "A 203.0.113.10"
        ],
        [
          "Signature",
          "RRSIG by key 47362"
        ],
        [
          "Valid",
          "31 Oct to 21 Nov 2026"
        ]
