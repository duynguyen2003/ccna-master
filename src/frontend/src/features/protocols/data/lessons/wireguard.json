            "src": "192.168.1.10",
            "dst": "192.0.2.51",
            "proto": "WireGuard",
            "info": "Keepalive, receiver=0x4f2a7c13, counter=1",
            "len": "74 B",
            "wire": {
              "udp": {
                "sport": 54016,
                "dport": 51820,
