  "overview": {
    "full": "Transmission Control Protocol",
    "description": "TCP turns the internet’s best-effort packet delivery into a reliable, ordered stream of bytes. It numbers every byte, acknowledges what arrives, resends what goes missing, and paces the sender so neither the other side nor the network is overwhelmed.",
    "facts": [
      [
        "Layer",
        "Transport (Layer 4)"
      ],
      [
        "Connection",
        "Three-way handshake"
      ],
      [
        "Reliability",
        "Sequence numbers + ACKs"
      ],
      [
        "Recovery",
        "Retransmission"
      ],
      [
        "Header",
        "20–60 bytes"
      ],
      [
        "Defined In",
        "RFC 9293"
      ]
    ]
  },
  "outro": {
    "title": "Connection closed",
    "desc": "Every byte accounted for",
    "text": "TCP opened a connection, numbered and acknowledged every byte, spotted a gap and resent just the missing segment, then closed both directions cleanly. curl received every byte in order and never saw the loss. Press REPLAY to watch it again.",
    "facts": [
      [
        "Segments",
        "14 (1 lost, 1 resent)"
      ],
      [
        "Bytes delivered",
        "78 up, 2,920 down"
      ],
      [
        "Loss found by",
        "Duplicate ACK + SACK"
      ],
      [
        "Total time",
        "0.148 s"
      ]
    ]
  },
