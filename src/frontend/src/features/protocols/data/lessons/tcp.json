    {
      "title": "A Gap Is Noticed",
      "desc": "Duplicate ACK with SACK",
      "detail": "Bytes 1461–2920 arrive, but 1–1460 never did. An ACK can only count bytes received in order, so the laptop repeats ACK 1 at once and adds a SACK block saying it already holds 1461–2920.",
      "facts": [
        [
          "ACK",
          "1 (still waiting for byte 1)"
        ],
        [
          "SACK",
          "holds bytes 1461–2920"
        ],
        [
          "Sent",
          "At once, not delayed"
        ]
      ],
      "events": [
