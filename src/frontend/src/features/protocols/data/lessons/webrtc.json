  "overview": {
    "full": "Web Real-Time Communication",
    "description": "WebRTC lets two browsers call each other, with audio, video and data going straight between them, not through a server. A server only introduces them: they swap descriptions of what they can send and where they can be reached (signalling), find a way through both home routers with ICE and STUN, encrypt with DTLS, and send the media over UDP as SRTP.",
    "facts": [
      [
        "Layer",
        "Application (Layer 7)"
      ],
      [
        "Media over",
        "UDP (SRTP)"
      ],
      [
        "Setup",
        "SDP, ICE, STUN, DTLS"
      ],
      [
        "Encryption",
        "Always on"
      ],
      [
        "Works in",
        "Every major browser"
      ],
      [
        "Defined In",
        "W3C; RFC 8825 and others"
      ]
    ]
  },
  "outro": {
    "title": "On the call",
    "desc": "Introduced by a server, then direct",
    "text": "The signalling server passed the offer and the answer between the two browsers, a STUN server told the laptop its public address, and an ICE check found a way through both home routers. After a DTLS handshake, encrypted audio and video went straight from one laptop to the other. Press REPLAY to watch it again.",
    "facts": [
      [
        "Signalling",
        "Via call.example.com"
      ],
      [
        "Media path",
        "Direct, through 2 NATs"
      ],
      [
        "Encryption",
        "DTLS, then SRTP"
      ],
      [
        "If blocked",
        "A TURN relay"
      ]
    ]
  },
