    {
      "title": "What Still Shows",
      "desc": "Hidden on the way, not from the resolver",
      "detail": "On the way, the lookups now look like any HTTPS traffic to dns.google. But the resolver itself reads every question, so you are trusting it instead of whoever runs your network. And the site you then visit is still seen by its IP address, and by its name in the TLS Client Hello unless it supports Encrypted Client Hello. DNS over TLS does the same job on port 853.",
      "facts": [
        [
          "Resolver",
          "Sees every name"
        ],
        [
          "Then visible",
          "The site’s IP, maybe its name"
        ],
        [
          "Alternative",
          "DNS over TLS (port 853)"
        ]
      ],
      "events": [
        {
          "type": "note",
          "at": "dns",
          "text": "TRUST MOVES TO THE RESOLVER",
          "tone": "navy"
        }
      ]
    }
