  "overview": {
    "full": "DNS queries inside HTTPS",
    "description": "Ordinary DNS travels in the clear: anyone on the same Wi-Fi, and your internet provider, can read every name you look up and even change the answers. DNS over HTTPS (DoH) sends the same DNS messages inside an encrypted HTTPS connection to the resolver, so on the way they look like any other web traffic. Browsers and operating systems can turn it on.",
    "facts": [
      [
        "Layer",
        "Application (Layer 7)"
      ],
      [
        "Port",
        "443 (HTTPS)"
      ],
      [
        "Carries",
        "Ordinary DNS messages"
      ],
      [
        "Hides",
        "Which names you look up"
      ],
      [
        "Similar",
        "DNS over TLS (port 853)"
      ],
      [
        "Defined In",
        "RFC 8484"
      ]
    ]
  },
  "outro": {
    "title": "Looked up in private",
    "desc": "Same question, sealed",
    "text": "The plain lookup could be read by anyone on the path. Over HTTPS the same DNS message was sealed inside TLS, readable only by the resolver. The resolver still sees every question, so the trust moves to it, and the site you then visit can still be seen by its address. Press REPLAY to watch it again.",
    "facts": [
      [
        "On the way",
        "Only “HTTPS to dns.google”"
      ],
      [
        "The resolver",
        "Still sees every name"
      ],
      [
        "Still visible",
        "The site’s address you then visit"
      ],
      [
        "Answers",
        "Can’t be changed on the way"
      ]
    ]
  },
