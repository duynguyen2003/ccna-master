    {
      "title": "Sealed Question",
      "desc": "A DNS message in an HTTP request",
      "detail": "The question is the same DNS message as before. It goes in an HTTP/2 request, GET /dns-query?dns= followed by the message in base64url, asking for an answer in the type application/dns-message. Inside TLS, nobody on the way can read it.",
      "facts": [
        [
          "Request",
          "GET /dns-query?dns=…"
        ],
        [
          "Format",
          "application/dns-message"
        ],
        [
          "On the way",
          "Encrypted (TLS)"
        ]
      ],
