    {
      "title": "Messages 1 and 2",
      "desc": "The 4-way handshake: nonces",
      "detail": "Both sides already hold the same key, worked out from the password and the network’s name (the PMK); it never goes over the air. The access point sends a random number, the ANonce. The laptop sends its own, the SNonce, with a check value (MIC). From the PMK, the two nonces and both MAC addresses, each side now works out the same session keys.",
      "facts": [
        [
          "Shared key",
          "PMK, from the password"
        ],
        [
          "Exchanged",
          "Two random nonces"
        ],
        [
          "Worked out",
          "Session keys (PTK)"
        ]
      ],
      "events": [
        {
          "type": "packet",
          "from": "router",
          "to": "client",
          "color": "teal",
          "label": "MESSAGE 1",
          "payload": [
            "ANonce"
          ],
          "row": {
            "time": "0.060s",
            "src": "00:00:5e:00:53:01",
            "dst": "00:00:5e:00:53:10",
            "proto": "EAPOL",
            "info": "Key (Message 1 of 4)",
            "len": "133 B",
            "wire": {
              "wifi": {
                "from": "ap",
                "kind": "eapol",
                "seq": 1524,
                "duration": 44,
                "msg": 1
