  "overview": {
    "full": "Wi-Fi (802.11) with WPA2",
    "description": "Wi-Fi carries a network over radio. Before a device can send anything, it has to find the network, join it and prove it knows the password. With WPA2-Personal that proof is the 4-way handshake: four short messages that turn the password into fresh encryption keys, without the password ever going over the air.",
    "facts": [
      [
        "Layer",
        "Data Link (Layer 2)"
      ],
      [
        "Standard",
        "IEEE 802.11"
      ],
      [
        "Security",
        "WPA2: CCMP (AES)"
      ],
      [
        "Joining",
        "Probe, authenticate, associate"
      ],
      [
        "Keys from",
        "The 4-way handshake"
      ],
      [
        "Defined In",
        "IEEE 802.11-2020"
      ]
    ]
  },
  "outro": {
    "title": "Connected",
    "desc": "Eleven frames to a secure link",
    "text": "The laptop found the network, joined it with two formalities and proved it knew the password in a four-message handshake, without ever sending it. Everything after that was encrypted with keys made for this connection alone. Press REPLAY to watch it again.",
    "facts": [
      [
        "Frames to join",
        "11"
      ],
      [
        "Password sent",
        "Never"
      ],
      [
        "Session keys",
        "New every time"
      ],
      [
        "Next",
        "DHCP, for an IP address"
      ]
    ]
  },
