  "overview": {
    "full": "Internet Message Access Protocol",
    "description": "IMAP lets mail apps work with a mailbox that stays on the server. Folders, read and flagged marks and deletions are kept there, so a phone, a laptop and webmail all see the same mailbox. The server can also tell an app about new mail as it arrives.",
    "facts": [
      [
        "Layer",
        "Application (Layer 7)"
      ],
      [
        "Ports",
        "993 (TLS), 143 (STARTTLS)"
      ],
      [
        "Transport",
        "TCP"
      ],
      [
        "Model",
        "Mail stays on the server"
      ],
      [
        "Syncs",
        "Folders and flags"
      ],
      [
        "Defined In",
        "RFC 9051, RFC 3501"
      ]
    ]
  },
  "outro": {
    "title": "Mailbox in sync",
    "desc": "Read once, read everywhere",
    "text": "Bob’s app opened his inbox, read a message, which marked it \\Seen on the server for all his devices, and then waited with IDLE until the server announced new mail. Nothing was deleted: the server still holds everything.",
    "facts": [
      [
        "Messages",
        "2, then 3 (new mail)"
      ],
      [
        "Read mark",
        "\\Seen, stored on server"
      ],
      [
        "New mail",
        "Pushed during IDLE"
      ],
      [
        "Port",
        "993, TLS from the start"
      ]
    ]
  },
