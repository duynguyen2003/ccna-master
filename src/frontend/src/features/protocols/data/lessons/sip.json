  "overview": {
    "full": "Session Initiation Protocol",
    "description": "SIP sets up phone calls over the internet: office desk phones, phone apps and the providers behind them. A phone signs in with its provider’s SIP server. To call someone it sends an INVITE; the other phone rings and answers, and the two agree on how to send the voice, which then flows as RTP. The messages are plain text, a lot like HTTP.",
    "facts": [
      [
        "Layer",
        "Application (Layer 7)"
      ],
      [
        "Port",
        "UDP or TCP 5060"
      ],
      [
        "Call setup",
        "INVITE, 180, 200, ACK"
      ],
      [
        "Voice",
        "RTP, described by SDP"
      ],
      [
        "Codec here",
        "G.711, 64 kbit/s"
      ],
      [
        "Defined In",
        "RFC 3261"
      ]
    ]
  },
  "outro": {
    "title": "Call ended",
    "desc": "Signed in, rang, talked, hung up",
    "text": "Alice’s phone signed in with a password it never sent, invited Bob’s phone through the SIP server, heard it ring, and talked over RTP until Bob hung up with a BYE. SIP only set the call up and took it down; the voice travelled as packets of its own. Press REPLAY to watch it again.",
    "facts": [
      [
        "Requests",
        "REGISTER, INVITE, ACK, BYE"
      ],
      [
        "Voice",
        "50 packets a second each way"
      ],
      [
        "Through",
        "The provider’s server"
      ],
      [
        "Encrypted",
        "No (SIPS and SRTP add it)"
      ]
    ]
  },
