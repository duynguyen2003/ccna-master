  "overview": {
    "full": "Socket Secure, version 5",
    "description": "SOCKS is a general-purpose proxy. Where an HTTP proxy understands web requests, a SOCKS proxy simply opens a connection on your behalf and copies the bytes, whatever the protocol: web, email, games, SSH. Apps use it to reach a network through one gateway, or to hide their own address; ssh -D and Tor both offer one.",
    "facts": [
      [
        "Layer",
        "Session (Layer 5)"
      ],
      [
        "Port",
        "1080"
      ],
      [
        "Carries",
        "Any TCP, and UDP"
      ],
      [
        "Logins",
        "None, or user and password"
      ],
      [
        "Offered by",
        "ssh -D, Tor, proxy servers"
      ],
      [
        "Defined In",
        "RFC 1928, RFC 1929"
      ]
    ]
  },
  "outro": {
    "title": "Tunnel open",
    "desc": "A few bytes, then just copying",
    "text": "Four tiny messages told the proxy where to connect; after that it only copied bytes. The website saw the proxy’s address, and because the laptop sent a name rather than an address, even the DNS lookup happened at the proxy. Press REPLAY to watch it again.",
    "facts": [
      [
        "Setup",
        "4 messages, 37 bytes"
      ],
      [
        "Server sees",
        "The proxy (192.0.2.80)"
      ],
      [
        "DNS lookup",
        "At the proxy"
      ],
      [
        "Encryption",
        "Only the TLS inside"
      ]
    ]
  },
