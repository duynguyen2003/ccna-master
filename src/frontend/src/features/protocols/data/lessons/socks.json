    {
      "title": "Greeting",
      "desc": "Version 5, and how to log in",
      "detail": "The laptop sends three bytes: version 5, one login method offered, and that method, 0: no login. The proxy answers with two: version 5, method 0. Had it chosen method 2, the app would next send a user name and password, in plain text.",
      "facts": [
        [
          "Laptop sends",
          "05 01 00 (3 bytes)"
        ],
        [
          "Proxy answers",
          "05 00 (2 bytes)"
        ],
        [
          "Login",
          "None needed here"
        ]
      ],
