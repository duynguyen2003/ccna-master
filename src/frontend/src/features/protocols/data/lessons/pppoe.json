  "overview": {
    "full": "Point-to-Point Protocol over Ethernet",
    "description": "Many DSL and fibre providers make the home router log in before it gets online. PPPoE is how: the router finds the provider’s access server and opens a session with it, then runs PPP inside, agreeing on the link’s settings, logging in with the username and password from the provider and receiving its public IP address. Every packet then carries an 8-byte PPPoE header.",
    "facts": [
      [
        "Layer",
        "Data Link (Layer 2)"
      ],
      [
        "Discovery",
        "PADI, PADO, PADR, PADS"
      ],
      [
        "Login",
        "CHAP or PAP"
      ],
      [
        "Address",
        "From IPCP"
      ],
      [
        "Overhead",
        "8 bytes (MTU 1,492)"
      ],
      [
        "Defined In",
        "RFC 2516, RFC 1661"
      ]
    ]
  },
  "outro": {
    "title": "Logged in",
    "desc": "Found, agreed, checked, addressed",
    "text": "The router found the provider’s access server, got a session, agreed on the link’s settings, proved its password without sending it and was given its public address. Every packet now travels inside that session, until a PADT ends it. Press REPLAY to watch it again.",
    "facts": [
      [
        "Messages",
        "17 to get online"
      ],
      [
        "Password",
        "Never sent"
      ],
      [
        "Public IP",
        "198.51.100.7"
      ],
      [
        "Overhead",
        "8 bytes per packet"
      ]
    ]
  },
