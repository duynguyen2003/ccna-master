    {
      "title": "Online",
      "desc": "Every packet in an 8-byte wrapper",
      "detail": "The laptop opens a website. The router swaps in its public address (NAT) and sends the packet inside the session: a 6-byte PPPoE header, then 2 bytes saying “IPv4”. It also lowers the MSS the laptop offered from 1460 to 1452, so the replies fit in 1,492 bytes.",
      "facts": [
        [
          "Wrapper",
          "6 + 2 bytes"
        ],
        [
          "Largest packet",
          "1,492 bytes"
        ],
        [
          "MSS",
          "1460 → 1452 (clamped)"
        ]
      ],
