  "steps": [
    {
      "title": "Anyone There?",
      "desc": "The router looks for an access server",
      "detail": "The home router is plugged into the provider’s fibre or DSL line. Before it can log in, it has to find the provider’s access server, so it broadcasts a PADI: “PPPoE Active Discovery Initiation”. An access server answers with a PADO, an offer that names it: bng-1.example.net.",
      "facts": [
        [
          "Asks",
          "PADI, to everyone"
        ],
        [
          "Answer",
          "PADO, from the server"
        ],
        [
          "Ethernet type",
          "0x8863 (discovery)"
        ]
      ],
      "events": [
        {
          "type": "show",
          "nodes": [
            "bng"
          ],
          "frame": "line"
        },
        {
          "type": "packet",
          "from": "router",
          "to": "bng",
          "color": "slate",
          "label": "PADI",
          "payload": [
            "is there an access server?",
            "to ff:ff:ff:ff:ff:ff"
          ],
          "row": {
            "time": "0.000s",
            "src": "00:00:5e:00:53:02",
            "dst": "Broadcast",
            "proto": "PPPoED",
            "info": "Active Discovery Initiation (PADI)",
            "len": "60 B",
            "wire": {
              "pppoe": {
                "code": 9,
                "session": 0,
                "tags": [
                  [
                    "service",
                    ""
                  ],
                  [
                    "host"
                  ]
                ]
              }
            }
          }
        },
        {
          "type": "packet",
          "from": "bng",
          "to": "router",
          "color": "slate",
          "label": "PADO",
          "payload": [
            "AC-Name: bng-1.example.net",
            "and a cookie"
          ],
          "row": {
            "time": "0.006s",
            "src": "00:00:5e:00:53:fe",
            "dst": "00:00:5e:00:53:02",
            "proto": "PPPoED",
            "info": "Active Discovery Offer (PADO) AC-Name='bng-1.example.net'",
            "len": "73 B",
            "wire": {
              "pppoe": {
                "code": 7,
                "session": 0,
                "tags": [
                  [
                    "ac",
                    "bng-1.example.net"
                  ],
                  [
                    "service",
                    ""
                  ],
                  [
                    "cookie"
                  ],
                  [
                    "host"
                  ]
                ]
              }
            }
          }
        }
      ]
    },
    {
      "title": "Pick a Server",
      "desc": "A session number for the line",
      "detail": "If several servers answered, the router picks one and asks it directly with a PADR, sending back the cookie it was given. The server replies with a PADS carrying a session ID, 0x2f1c. From now on every frame between the two of them carries that number.",
      "facts": [
        [
          "Request",
          "PADR"
        ],
        [
          "Confirmed",
          "PADS"
        ],
        [
          "Session ID",
          "0x2f1c"
        ]
