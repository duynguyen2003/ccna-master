{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "data": {
      "type": "object",
      "properties": {
        "callId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "receiptHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recorded": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "callId",
        "receiptHash",
        "recorded"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contractVersion",
    "data"
  ],
  "additionalProperties": false,
  "$id": "urn:ccna:ai-lab:v1:ReceiptResponse"
}
