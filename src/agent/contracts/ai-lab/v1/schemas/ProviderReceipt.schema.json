{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "contractVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "requestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "callId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "contextHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "leaseVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "providerRequestId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[\\s\\S]{1,200}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "usage": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "FINAL"
                },
                "inputTokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "outputTokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "reasoningTokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "status",
                "inputTokens",
                "outputTokens",
                "reasoningTokens"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "UNRESOLVED"
                },
                "inputTokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "outputTokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reasoningTokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "status",
                "inputTokens",
                "outputTokens",
                "reasoningTokens"
              ],
              "additionalProperties": false
            }
          ]
        },
        "versions": {
          "type": "object",
          "properties": {
            "contextSchemaVersion": {
              "type": "string",
              "const": "1.0.0"
            },
            "simulatorVersion": {
              "type": "string",
              "pattern": "^[\\s\\S]{1,40}$"
            },
            "diagnosticVersion": {
              "type": "string",
              "pattern": "^[\\s\\S]{1,80}$"
            },
            "promptVersion": {
              "type": "string",
              "pattern": "^[\\s\\S]{1,80}$"
            },
            "policyVersion": {
              "type": "string",
              "pattern": "^[\\s\\S]{1,80}$"
            },
            "modelVersion": {
              "type": "string",
              "pattern": "^[\\s\\S]{1,120}$"
            },
            "priceVersion": {
              "type": "string",
              "pattern": "^[\\s\\S]{1,80}$"
            },
            "appCommit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          },
          "required": [
            "contextSchemaVersion",
            "simulatorVersion",
            "diagnosticVersion",
            "promptVersion",
            "policyVersion",
            "modelVersion",
            "priceVersion",
            "appCommit"
          ],
          "additionalProperties": false
        },
        "finishReason": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,80}$"
        },
        "outcome": {
          "type": "string",
          "const": "RECEIVED"
        },
        "output": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "pattern": "^[\\s\\S]{1,6000}$"
            },
            "claimType": {
              "type": "string",
              "enum": [
                "SUPPORTED_FINDING",
                "HYPOTHESIS",
                "NO_ISSUE_OBSERVED",
                "INSUFFICIENT_CONTEXT",
                "UNSUPPORTED"
              ]
            },
            "evidenceIds": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z][A-Za-z0-9_-]{0,79}$"
              }
            },
            "nextSteps": {
              "maxItems": 2,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "pattern": "^[\\s\\S]{1,1000}$"
                  },
                  "commandId": {
                    "type": "string",
                    "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z][A-Za-z0-9_-]{0,79}$"
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              }
            },
            "verification": {
              "type": "string",
              "pattern": "^[\\s\\S]{1,1000}$"
            },
            "hintLevel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          },
          "required": [
            "summary",
            "claimType",
            "evidenceIds",
            "nextSteps",
            "verification",
            "hintLevel"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contractVersion",
        "requestId",
        "callId",
        "contextHash",
        "leaseVersion",
        "providerRequestId",
        "usage",
        "versions",
        "finishReason",
        "outcome",
        "output"
      ],
      "additionalProperties": false
    },
