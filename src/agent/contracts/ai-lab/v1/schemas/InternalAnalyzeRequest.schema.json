                        "0.0.0.0",
                        "128.0.0.0",
                        "192.0.0.0",
                        "224.0.0.0",
                        "240.0.0.0",
                        "248.0.0.0",
                        "252.0.0.0",
                        "254.0.0.0",
                        "255.0.0.0",
                        "255.128.0.0",
                        "255.192.0.0",
                        "255.224.0.0",
                        "255.240.0.0",
                        "255.248.0.0",
                        "255.252.0.0",
                        "255.254.0.0",
                        "255.255.0.0",
                        "255.255.128.0",
                        "255.255.192.0",
                        "255.255.224.0",
                        "255.255.240.0",
                        "255.255.248.0",
                        "255.255.252.0",
                        "255.255.254.0",
                        "255.255.255.0",
                        "255.255.255.128",
                        "255.255.255.192",
                        "255.255.255.224",
                        "255.255.255.240",
                        "255.255.255.248",
                        "255.255.255.252",
                        "255.255.255.254",
                        "255.255.255.255"
                      ]
                    },
                    "nextHop": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "protocol": {
                      "type": "string",
                      "enum": [
                        "C",
                        "S",
                        "O",
                        "D"
                      ]
                    }
