{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "AI_INTERNAL_ERROR",
            "AI_INVALID_REQUEST",
            "UNAUTHORIZED",
            "AI_NOT_ELIGIBLE",
            "AI_RESOURCE_NOT_FOUND",
            "AI_STALE_CONTEXT",
            "AI_IDEMPOTENCY_CONFLICT",
            "AI_CONVERSATION_CHANGED",
            "AI_RECOVERY_RECONFIRM",
            "AI_DISPATCH_ALREADY_CLAIMED",
            "AI_RECEIPT_CONFLICT",
            "AI_LEASE_LOST",
            "AI_CONTEXT_TOO_LARGE",
            "AI_USER_RATE_LIMITED",
            "AI_QUOTA_EXHAUSTED",
            "AI_CONCURRENT_LIMIT",
            "AI_CAPACITY_EXHAUSTED",
            "AI_DISABLED",
            "AI_BUDGET_PAUSED"
          ]
        },
        "message": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,1000}$"
        },
        "requestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "retryAfterSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "resetAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contractVersion",
    "error"
  ],
  "additionalProperties": false,
  "$id": "urn:ccna:ai-lab:v1:ErrorResponse"
}
