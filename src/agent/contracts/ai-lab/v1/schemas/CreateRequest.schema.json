{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "contractVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "clientRequestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "conversationEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recoveryEpoch": {
          "type": "string",
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z][A-Za-z0-9_-]{0,79}$"
        },
        "intent": {
          "type": "string",
          "const": "NEXT_STEP"
        },
        "message": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[\\s\\S]{1,2000}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "taskId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z][A-Za-z0-9_-]{0,79}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestedHintLevel": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "selectedDeviceId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z][A-Za-z0-9_-]{0,79}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "contractVersion",
        "clientRequestId",
        "expectedRevision",
        "conversationEpoch",
        "recoveryEpoch",
        "intent"
      ],
      "additionalProperties": false
    },
