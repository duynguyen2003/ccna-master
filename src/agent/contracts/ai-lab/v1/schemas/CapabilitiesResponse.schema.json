{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "data": {
      "type": "object",
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "conversationId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "conversationEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recoveryEpoch": {
          "type": "string",
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z][A-Za-z0-9_-]{0,79}$"
        },
        "intents": {
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "NEXT_STEP",
              "DIAGNOSE",
              "EXPLAIN_CONCEPT",
              "LAB_REVIEW"
            ]
          }
        },
        "supportedDeviceIds": {
          "maxItems": 24,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z][A-Za-z0-9_-]{0,79}$"
          }
        },
        "supportedTopics": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z][A-Za-z0-9_-]{0,79}$"
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "questionCharacters": {
              "type": "number",
              "const": 2000
            },
            "contextBytes": {
              "type": "number",
              "const": 65536
            },
            "userConcurrent": {
              "type": "number",
              "const": 1
            }
          },
          "required": [
            "questionCharacters",
            "contextBytes",
            "userConcurrent"
          ],
          "additionalProperties": false
        },
        "serverTime": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "eligible",
        "conversationId",
        "conversationEpoch",
        "recoveryEpoch",
        "intents",
        "supportedDeviceIds",
        "supportedTopics",
        "limits",
        "serverTime"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contractVersion",
    "data"
  ],
  "additionalProperties": false,
  "$id": "urn:ccna:ai-lab:v1:CapabilitiesResponse"
}
