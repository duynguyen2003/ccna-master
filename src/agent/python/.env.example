# Reference only: Python does not load this file or the application's .env.
# Export these through the shell/process manager or a Docker --env-file.
AI_PYTHON_MODE=off
AI_PYTHON_HOST=127.0.0.1
AI_PYTHON_PORT=8001
AI_PYTHON_ENVIRONMENT=local
AI_SERVICE_SECRET=
AI_PYTHON_NODE_URL=http://127.0.0.1:5500/internal/v1/ai
AI_PYTHON_MAX_BODY_BYTES=65536
AI_PYTHON_BODY_TIMEOUT_MS=2000
AI_PYTHON_MAX_REQUEST_MS=25000
AI_PYTHON_CALLBACK_TIMEOUT_MS=3000
AI_PYTHON_MAX_CONCURRENT=2
AI_PYTHON_RECEIPT_ATTEMPTS=3
# Local Gemini requires MODE=gemini, LIVE_ENABLED=true and a server-only key.
# Keep off/false unless intentionally running the bounded local flow.
AI_PYTHON_LIVE_ENABLED=false
GEMINI_API_KEY=
