# Server-only values; merge into deployment secrets, never the frontend environment.
NODE_ENV=production
AI_PRODUCTION_ENABLED=false
AI_ENVIRONMENT=production
AI_WORKER_MODE=production-gemini
# Full deployed commit SHA. Render also supplies RENDER_GIT_COMMIT automatically.
AI_RELEASE_SHA=
AI_RECOVERY_EPOCH=
AI_SERVICE_SECRET=
AI_OWNER_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_STATUS_STREAM_ENABLED=true
LAB_AI_MODE=deterministic
# Launcher fills loopback callback with the actual PORT when this is omitted.
# AI_INTERNAL_URL=http://127.0.0.1:5000/internal/v1/ai
AI_ANALYZE_URL=http://127.0.0.1:8001/internal/v1/lab-assistant/analyze
