{
  "name": "@ccna/agent",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "exports": {
    "./node/*": "./node/*.js",
    "./routes/*": "./routes/*.js",
    "./workers/*": "./workers/*.js"
  },
  "scripts": {
    "worker": "node workers/aiWorker.js",
    "test": "node --test node/access.test.js node/snapshot.test.js node/worker.test.js node/context.test.js node/contract.test.js node/localGemini.test.js node/pythonTransport.test.js node/diagnostics/*.test.js tests/*.test.js",
    "test:storage": "node scripts/test-ai-lab-storage.cjs",
    "check:contracts": "node scripts/generate-ai-lab-contracts.cjs --check",
    "check:fixtures": "node scripts/generate-ai-lab-fixtures.cjs --check"
  },
  "dependencies": {
    "@ccna/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  }
}
