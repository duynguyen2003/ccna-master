# Database Connection
DATABASE_URL="postgresql://username:password@localhost:5432/your_database_name"

# Local development ports
# React reads PORT; Express prefers BACKEND_PORT.
PORT=3000
BACKEND_PORT=5500
REACT_APP_API_URL="http://localhost:5500/api"

# Security
POSTGRES_DB=netmastery_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
FRONTEND_URL=http://localhost:3000
# Direct access: 0. Docker Nginx as the only ingress: 1.
TRUST_PROXY=0
# Local Gemini feedback explanations (server only); run pnpm ai:live:init first.
# Set LAB_AI_MODE=local-live to opt in. Production stays disabled.
LAB_AI_MODE=deterministic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Legacy direct-provider settings are ignored; the async provider adapter is not enabled yet.
LAB_AI_URL=
LAB_AI_KEY=
LAB_AI_MODEL=

JWT_SECRET=
JWT_EXPIRES_IN="24h"

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Google Auth (OAuth 2.0)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
REACT_APP_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Local upload storage, relative to the repository root.
UPLOADS_DIR=src/storage/uploads

# R1 admission (BE-03): requires migrated DB and an explicit AiRuntimePolicy.
# Keep owner secret stable across replicas; rotate recovery epoch after DB restore.
# Empty values intentionally disable admission; never expose these as REACT_APP_*.
AI_ENVIRONMENT=local
AI_RECOVERY_EPOCH=
AI_OWNER_SECRET=

# BE-04: disabled by default. Fake mode is restricted to the isolated local AI DB.
AI_WORKER_MODE=off
AI_SERVICE_SECRET=
AI_INTERNAL_URL=http://127.0.0.1:5500/internal/v1/ai
