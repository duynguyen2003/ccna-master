{
  "name": "ccna-master",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "pnpm": "10.33.4"
  },
  "scripts": {
    "preinstall": "node src/scripts/require-pnpm.cjs",
    "start": "pnpm --dir src/frontend start",
    "server": "node src/backend/src/Server.js",
    "build": "pnpm --dir src/frontend build",
    "test": "pnpm --dir src/frontend test",
    "check:icons": "node src/scripts/check-icons.cjs",
    "test:cli": "node --test src/backend/src/simulation/*.test.js",
    "test:learning": "node --test src/backend/src/learningPath/*.test.js",
    "test:core": "node --test src/backend/src/exams/*.test.js src/backend/src/security/*.test.js",
    "db:deploy": "prisma migrate deploy",
    "backup": "node src/scripts/backup.cjs",
    "restore": "node src/scripts/restore.cjs",
    "bench:cli": "node src/backend/src/simulation/benchmark.js",
    "import:lab:eigrp01": "node src/scripts/import-eigrp01.cjs",
    "prisma:generate": "prisma generate",
    "format": "prettier --write \"src/frontend/src/**/*.{js,jsx,css,json}\" \"src/backend/src/**/*.js\" \"src/shared/**/*.{js,json}\" \"src/scripts/**/*.{js,cjs}\"",
    "ui:review:build": "node ../lab-ui-review/build.cjs",
    "ui:review:serve": "node ../lab-ui-review/serve.cjs",
    "postinstall": "node src/scripts/prisma-postinstall.cjs",
    "check:boundaries": "node src/scripts/check-boundaries.cjs"
  },
  "dependencies": {
    "@ccna/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "eslint": "^8.57.1",
    "prettier": "^3.6.2",
    "prisma": "^7.6.0",
    "eslint-config-react-app": "7.0.1",
    "@babel/parser": "7.29.7"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  }
}
