{
  "name": "ccna-master",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "pnpm": "10.33.4"
  },
  "scripts": {
    "preinstall": "node src/scripts/require-pnpm.cjs",
    "start": "pnpm --dir src/frontend start",
    "server": "node src/backend/src/Server.js",
    "ai:worker": "node src/agent/workers/aiWorker.js",
    "build": "pnpm --dir src/frontend build",
    "test": "pnpm --dir src/frontend test",
    "check:icons": "node src/scripts/check-icons.cjs",
    "test:cli": "node --test src/backend/src/simulation/*.test.js src/agent/tests/aiLabCertification.test.js",
    "test:ai": "pnpm --dir src/agent test",
    "test:ai:python": "uv run --directory src/agent/python --frozen pytest",
    "test:ai:python:integration": "node src/agent/scripts/test-python-integration.cjs",
    "ai:python:live:check": "node src/agent/scripts/test-python-integration.cjs --live",
    "check:ai:python": "uv run --directory src/agent/python --frozen ruff check app tests",
    "check:ai:fixtures": "node src/agent/scripts/generate-ai-lab-fixtures.cjs --check",
    "test:ai:contracts": "node --test src/agent/node/contract.test.js",
    "test:ai:context": "node --test src/agent/node/context.test.js",
    "test:ai:diagnostics": "node --test src/agent/node/diagnostics/diagnostics.test.js",
    "test:ai:local": "node --test src/agent/node/localGemini.test.js",
    "test:ai:storage": "node src/agent/scripts/test-ai-lab-storage.cjs",
    "check:ai:contracts": "node src/agent/scripts/generate-ai-lab-contracts.cjs --check",
    "check:ai:budget": "node src/agent/scripts/check-ai-lab-budget.cjs",
    "ai:live:init": "node src/agent/scripts/check-gemini-live.cjs --init",
    "ai:live:check": "node src/agent/scripts/check-gemini-live.cjs",
    "ai:live:status": "node src/agent/scripts/check-gemini-live.cjs --status",
    "ai:db:start": "node src/agent/scripts/ai-lab-local-db.cjs start",
    "ai:db:status": "node src/agent/scripts/ai-lab-local-db.cjs status",
    "ai:db:stop": "node src/agent/scripts/ai-lab-local-db.cjs stop",
    "test:learning": "node --test src/backend/src/learningPath/*.test.js",
    "test:core": "node --test src/backend/src/exams/*.test.js src/backend/src/security/*.test.js",
    "db:deploy": "prisma migrate deploy",
    "backup": "node src/scripts/backup.cjs",
    "restore": "node src/scripts/restore.cjs",
    "bench:cli": "node src/backend/src/simulation/benchmark.js",
    "import:lab:eigrp01": "node src/scripts/import-eigrp01.cjs",
    "prisma:generate": "prisma generate",
    "format": "prettier --write \"src/frontend/src/**/*.{js,jsx,css,json}\" \"src/backend/src/**/*.js\" \"src/agent/**/*.{js,cjs,mjs,ts,md}\" \"src/agent/{package.json,contracts/package.json}\" \"src/shared/**/*.{js,json}\" \"src/scripts/**/*.{js,cjs}\"",
    "ui:review:build": "node ../lab-ui-review/build.cjs",
    "ui:review:serve": "node ../lab-ui-review/serve.cjs",
    "postinstall": "node src/scripts/prisma-postinstall.cjs",
    "check:boundaries": "node src/scripts/check-boundaries.cjs"
  },
  "dependencies": {
    "@ccna/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "eslint": "^8.57.1",
    "prettier": "^3.6.2",
    "prisma": "^7.6.0",
    "eslint-config-react-app": "7.0.1",
    "@babel/parser": "7.29.7"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  }
}
